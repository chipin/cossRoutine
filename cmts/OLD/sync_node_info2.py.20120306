#!/usr/bin/env python
# -*- coding: big5 -*-
import sys,datetime,time
import pymssql
from oraclass import ORA

if len(sys.argv) > 3 or len(sys.argv) < 2:
    print 'Error: Argument error'
    sys.exit(0)

so = mode = ''
so = sys.argv[1]

if len(sys.argv) == 3:
    if len(sys.argv[2]) > 0:
        mode = sys.argv[2].lower()
        if mode != 'full':
            mode = ''

someday = time.localtime(time.time()-3*24*60*60)
datestr = "%s-%02d-%02d 00:00:00" % (someday[0],someday[1],someday[2])

try:
    if so=='106':
        con = pymssql.connect(dsn='cnis_web@CossMS_CG_CP950')
    elif so in ['101','103','104','300','701']:
        con = pymssql.connect(dsn='cnis_web@TFMCossMS_CP950_HUGE')
        #con = pymssql.connect(dsn='cnis_web@TFMCossMS_CP950')
    else:
        con = pymssql.connect(dsn='cnis_web@kbroCossMS_CP950_HUGE')
        #con = pymssql.connect(dsn='cnis_web@kbroCossMS_CP950')
    cur = con.cursor()
except Exception, errmesg:
    print 'Error:',errmesg
    sys.exit(0)

oracon_upd = ORA('nms@cnis')
if not oracon_upd.db:
    sys.exit(0)

querysql = "select a.companyno,a.nodeno,sum(case when b.servicename='1 CATV' then 1 else 0 end) catv_cnt, \
            sum(case when b.servicename in ('2 CM','9 CMC') then 1 else 0 end) cm_cnt,max(c.mscity) a1,max(c.msdistrict) a2,max(c.addrname) a3,max(c.MSCOMMENT) a4, \
            sum(case when b.servicename in ('3 DSTB') then 1 else 0 end) dtv_cnt,sum(case when b.servicename in ('5 FTTB') then 1 else 0 end) fttb_cnt,sum(case when b.servicename in ('7 EOC') then 1 else 0 end) eoc_cnt,sum(case when b.servicename in ('8 LL') then 1 else 0 end) ll_cnt \
            from ms0102 a with (nolock) \
            inner join ms0200 b with (nolock) on b.companyno=a.companyno and b.custid=a.custid and substring(b.custstatus,1,1) in ('0','1','2','6','7','8','9','A') \
            inner join ms0030 c with (nolock) on c.companyno=a.companyno and c.hpunicode=a.hpunicode \
            where a.companyno='%s' and a.nodeno is not null and a.nodeno <> '' and a.nodeno <> '未設' and a.addrno=0 group by a.companyno,a.nodeno" % (so)
tme = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
print "[%s]" % (tme)
print querysql
cur.execute(querysql)
node_arr = {}
i = 0
while 1:
    curarr = cur.fetchmany(100)
    i = i+1
    if curarr:
        xlen = len(curarr)
        for ii in range(0, xlen):
            companyno = curarr[ii][0]
            nodeno = curarr[ii][1]
            catv_cnt = curarr[ii][2]
            cm_cnt = curarr[ii][3]
            r1 = curarr[ii][4]
            r2 = curarr[ii][5]
            r3 = curarr[ii][6]
            r4 = curarr[ii][7]
            dtv_cnt = curarr[ii][8]
            fttb_cnt = curarr[ii][9]
            eoc_cnt = curarr[ii][10]
            ll_cnt = curarr[ii][11]
            if r4!='':
                address = r1+r2+r3+'('+r4+')'
            else:
                address = r1+r2+r3
            print companyno,nodeno,address
            oraupdsql = "begin proc_cnis_upd_node_info('%s','%s','%d','%d','%s','%d','%d','%d','%d'); end;" % (companyno,nodeno,catv_cnt,cm_cnt,address,dtv_cnt,fttb_cnt,eoc_cnt,ll_cnt)
            print oraupdsql
            try:
                oracon_upd.execone(oraupdsql)
                oracon_upd.commit()
            except Exception, detail:
                print '%s,%s -> %s' % (companyno, nodeno, detail)
    else:
        break


if mode == 'full':
    querysql = "select a.companyno,a.nodeno,b.subsid,b.singlesn cmmac,b.custstatus,a.addrname,b.billitem,a.linkid \
                from ms0102 a with (nolock) \
                inner join ms0200 b with (nolock) on b.companyno=a.companyno and b.custid=a.custid and substring(b.custstatus,1,1) in ('0','1','2','6','7','8','9','A') and b.servicename in ('9 CMC') and b.singlesn is not null and b.singlesn <> '' \
                where a.companyno='%s' and a.nodeno is not null and a.nodeno <> '' and a.nodeno <> '未設' and a.addrno=0" % (so)
else:
    querysql = "select a.companyno,a.nodeno,b.subsid,b.singlesn cmmac,b.custstatus,a.addrname,b.billitem,a.linkid \
