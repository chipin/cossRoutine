#!/usr/bin/env python
# -*- coding: big5 -*-
import sys, re
import os
import string
import time
import threading
from pysnmpclass import snmpclass
from oraclass import ORA

#cm_rxpwr_mib  = '.1.3.6.1.2.1.10.127.1.1.1.1.6.3'  CM  DSPower.3 CM下行
#dlsnr_mib     = '.1.3.6.1.2.1.10.127.1.1.4.1.5.3'  CM  SignalNoise.3
#cm_txpwr_mib  = '.1.3.6.1.2.1.10.127.1.2.2.1.3.2'  CM  CmStatusTxPower.2 CMTS下行=CM上行
#cm_t3_mib     = '.1.3.6.1.2.1.10.127.1.2.2.1.12.2' CM  CmStatusT3Timeouts.2
#cm_t4_mib     = '.1.3.6.1.2.1.10.127.1.2.2.1.13.2' CM  CmStatusT4Timeouts.2
#cmprofile_mib = '.1.3.6.1.2.1.69.1.4.5.0'          CM  CmConfigFile
#cmip_mib      = '.1.3.6.1.2.1.10.127.1.3.3.1.3'    CmStatusIP
#rxpwr_mib     = '.1.3.6.1.2.1.10.127.1.3.3.1.6'    CmStatusRxPower CMTS上行
#cmstatus_mib  = '.1.3.6.1.2.1.10.127.1.3.3.1.9'    CmStatus
#ulsnr_mib     = '.1.3.6.1.2.1.10.127.1.3.3.1.13'   CmStatusSignalNoise

thread_cnt = 0
status_arr = {}
thread_arr = {}
snmp_oid = {}
mloop = 0

def query_status(loop, cmidx, cmts_ip, cmts_snmp):
    global snmp_oid, thread_cnt, status_arr
    thread_cnt = thread_cnt+1
    status_arr['DONE-'+str(loop)] = 0
    cm_ip = None
    try:
        agt = snmpclass(version='v2c',community=cmts_snmp,ptimeout=1,pretries=3,debug=0)
        agt_cm = snmpclass(version='v1',community='public',ptimeout=1,pretries=3,debug=0)

        if cmts_ip is not None:
            mib = "%s.%d" % (snmp_oid['docsIfCmtsCmStatusValue'], cmidx)
            rets = agt.snmpget([cmts_ip, '-c', cmts_snmp, mib])
            if rets is not None and rets[0][1] is not None and rets[0][1]!='':
                status_arr['STATUS-'+str(loop)] = int(rets[0][1])
            else:
                status_arr['STATUS-'+str(loop)] = -1

            if status_arr['STATUS-'+str(loop)] == 6:
                try:
                    mib = "%s.%d" % (snmp_oid['docsIfCmtsCmStatusIpAddress'], cmidx)
                    rets = agt.snmpget([cmts_ip, '-c', cmts_snmp, mib])
                    if rets is not None and rets[0][1]!='':
                        status_arr['CMIP-'+str(loop)] = rets[0][1]
                    else:
                        status_arr['CMIP-'+str(loop)] = ''
                except:
                    status_arr['CMIP-'+str(loop)] = ''
                cm_ip = status_arr['CMIP-'+str(loop)]

            mib = "%s.%d" % (snmp_oid['docsIfCmtsCmStatusSignalNoise'], cmidx)
            rets = agt.snmpget([cmts_ip, '-c', cmts_snmp, mib])
            if rets is not None and rets[0][1]!='':
                status_arr['ULSNR-'+str(loop)] = int(rets[0][1])/10.0
            else:
                status_arr['ULSNR-'+str(loop)] = 'null'

            mib = "%s.%d" % (snmp_oid['docsIf3CmtsCmUsStatusSignalNoise'], cmidx)
            rets = agt.snmpwalk([cmts_ip, '-c', cmts_snmp, mib])
            i = 0
            try:
                lens = len(rets)
            except:
                lens = 0
            while i<lens:
                if rets is not None and rets[i][1] is not None and rets[i][1]!='' and int(rets[i][1]) > 0:
                    status_arr['ULSNR-'+str(loop)+'-'+str(i)] = int(rets[0][1])/10.0
                else:
                    status_arr['ULSNR-'+str(loop)+'-'+str(i)] = 'null'
                i = i+1

            mib = "%s.%d" % (snmp_oid['docsIfCmtsCmStatusRxPower'], cmidx)
            rets = agt.snmpget([cmts_ip, '-c', cmts_snmp, mib])
            if rets is not None and rets[0][1]!='':
                status_arr['RXPWR-'+str(loop)] = int(rets[0][1])/10.0
            else:
                status_arr['RXPWR-'+str(loop)] = 'null'

            mib = "%s.%d" % (snmp_oid['docsIf3CmtsCmUsStatusRxPower'], cmidx)
            rets = agt.snmpwalk([cmts_ip, '-c', cmts_snmp, mib])
            i = 0
            try:
                lens = len(rets)
            except:
                lens = 0
            while i<lens:
                if rets is not None and rets[i][1] is not None and rets[i][1]!='':
                    status_arr['RXPWR-'+str(loop)+'-'+str(i)] = int(rets[0][1])/10.0
                else:
                    status_arr['RXPWR-'+str(loop)+'-'+str(i)] = 'null'
                i = i+1
        else:
            status_arr['STATUS-'+str(loop)] = -1
            status_arr['CMIP-'+str(loop)] = ''
            status_arr['ULSNR-'+str(loop)] = 'null'
            status_arr['RXPWR-'+str(loop)] = 'null'

        if cm_ip is not None and cm_ip != '' and len(cm_ip) > 0:
            mib = "%s" % (snmp_oid['docsIfSigQSignalNoise.3'])
            rets = agt_cm.snmpget([cm_ip, '-c', 'public', mib])
            if rets is not None and rets[0][1]!='':
                status_arr['DLSNR-'+str(loop)] = int(rets[0][1])/10.0
            else:
                status_arr['DLSNR-'+str(loop)] = 'null'

            mib = "%s" % (snmp_oid['docsIfDownChannelPower.3'])
            rets = agt_cm.snmpget([cm_ip, '-c', 'public', mib])
            if rets is not None and rets[0][1]!='':
                status_arr['CMRXPWR-'+str(loop)] = int(rets[0][1])/10.0
            else:
                status_arr['CMRXPWR-'+str(loop)] = 'null'

            mib = "%s" % (snmp_oid['docsIfCmStatusTxPower.2'])
            rets = agt_cm.snmpget([cm_ip, '-c', 'public', mib])
            if rets is not None and rets[0][1]!='':
                status_arr['CMTXPWR-'+str(loop)] = int(rets[0][1])/10.0
            else:
                status_arr['CMTXPWR-'+str(loop)] = 'null'

            mib = "%s" % (snmp_oid['docsIf3CmStatusUsTxPower'])
            rets = agt_cm.snmpwalk([cm_ip, '-c', 'public', mib])
            i = 0
            try:
                lens = len(rets)
            except:
                lens = 0
            while i<lens:
                if rets is not None and rets[i][1] is not None and rets[i][1]!='':
                    status_arr['CMTXPWR-'+str(loop)+'-'+str(i)] = int(rets[0][1])/10.0
                else:
                    status_arr['CMTXPWR-'+str(loop)+'-'+str(i)] = 'null'
                i = i+1

            mib = "%s" % (snmp_oid['docsIfCmStatusT3Timeouts.2'])
            rets = agt_cm.snmpget([cm_ip, '-c', 'public', mib])
            if rets is not None and rets[0][1]!='':
                status_arr['CMT3-'+str(loop)] = int(rets[0][1])
            else:
                status_arr['CMT3-'+str(loop)] = 'null'

            mib = "%s" % (snmp_oid['docsIfCmStatusT4Timeouts.2'])
            rets = agt_cm.snmpget([cm_ip, '-c', 'public', mib])
            if rets is not None and rets[0][1]!='':
                status_arr['CMT4-'+str(loop)] = int(rets[0][1])
            else:
                status_arr['CMT4-'+str(loop)] = 'null'

            mib = "%s" % (snmp_oid['CmConfigFile'])
            rets = agt_cm.snmpget([cm_ip, '-c', 'public', mib])
            if rets is not None and rets[0][1]!='':
                status_arr['PROFILE-'+str(loop)] = re.sub(r'[^\w\.\_\-]', '', rets[0][1])
            else:
                status_arr['PROFILE-'+str(loop)] = ''
        else:
            status_arr['CMIP-'+str(loop)] = ''
            status_arr['PROFILE-'+str(loop)] = ''
            status_arr['DLSNR-'+str(loop)] = 'null'
            status_arr['CMRXPWR-'+str(loop)] = 'null'
            status_arr['CMTXPWR-'+str(loop)] = 'null'
            status_arr['CMT3-'+str(loop)] = 'null'
            status_arr['CMT4-'+str(loop)] = 'null'
    except Exception, msg:
        print 'Exception:',loop,cmidx,cmts_ip,cmts_snmp,msg
        status_arr['STATUS-'+str(loop)] = None
    thread_cnt = thread_cnt-1
    status_arr['DONE-'+str(loop)] = 1

def to_DB(loop):
    global ora
    try:
        SQL = ''
        try:
            cm_cmip = status_arr['CMIP-'+str(loop)]
        except:
            cm_cmip = ''
        try:
            cm_profile = status_arr['PROFILE-'+str(loop)]
        except:
            cm_profile = ''

        try:
            rxpwr = status_arr['RXPWR-'+str(loop)+'-0']
        except:
            try:
                rxpwr = status_arr['RXPWR-'+str(loop)]
            except:
                rxpwr = 'null'
        try:
            rxpwr2 = status_arr['RXPWR-'+str(loop)+'-1']
        except:
            rxpwr2 = 'null'

        try:
            cm_rxpwr = status_arr['CMRXPWR-'+str(loop)]
        except:
            cm_rxpwr = 'null'

        try:
            cm_txpwr = status_arr['CMTXPWR-'+str(loop)+'-0']
        except:
            try:
                cm_txpwr = status_arr['CMTXPWR-'+str(loop)]
            except:
                cm_txpwr = 'null'
        try:
            cm_txpwr2 = status_arr['CMTXPWR-'+str(loop)+'-1']
        except:
            cm_txpwr2 = 'null'

        try:
            dl_snr = status_arr['DLSNR-'+str(loop)]
        except:
            dl_snr = 'null'

        try:
            ul_snr = status_arr['ULSNR-'+str(loop)+'-0']
        except:
            try:
                ul_snr = status_arr['ULSNR-'+str(loop)]
            except:
                ul_snr = 'null'
        try:
            ul_snr2 = status_arr['ULSNR-'+str(loop)+'-1']
        except:
            ul_snr2 = 'null'

        try:
            cm_t3 = status_arr['CMT3-'+str(loop)]
        except:
            cm_t3 = 'null'
        try:
            cm_t4 = status_arr['CMT4-'+str(loop)]
        except:
            cm_t4 = 'null'

        profile_sql = ''
        if cm_profile != '':
            profile_sql = ",cm_config_file='%s'" % (cm_profile)
        if cm_cmip != '':
            profile_sql = "%s,ip='%s'" % (profile_sql, cm_cmip)
        SQL = "update cmmac set synctime=trunc(sysdate,'MI'),status=%d,rxpwr=%s,rxpwr2=%s,cm_rxpwr=%s,cm_txpwr=%s,cm_txpwr2=%s,dl_snr=%s,ul_snr=%s,ul_snr2=%s,cm_t3=%s,cm_t4=%s %s where companyno='%s' and cmmac='%s'" % (status_arr['STATUS-'+str(loop)], rxpwr, rxpwr2, cm_rxpwr, cm_txpwr, cm_txpwr2, dl_snr, ul_snr, ul_snr2, cm_t3, cm_t4, profile_sql, status_arr['SO-'+str(loop)], status_arr['MAC-'+str(loop)])
        print str(loop) + ': ' + SQL
        try:
            ora.execone(SQL)
            ora.commit()
            #CSQL = "update cm_status set qos=decode(str_div(qos,'-',0,10),null,qos,str_div(qos,'-',0,10)) where cmmac='%s'" % (status_arr['MAC-'+str(loop)])
            #ora_coss.execone(CSQL)
            #ora_coss.commit()
        except Exception, msg:
            nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
            print '['+nowdate+']:'+str(msg)
        status_arr['STATUS-'+str(loop)] = None
        sys.stdout.flush()
    except Exception, msg:
        nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
        print '['+nowdate+']:'+str(msg)
    status_arr['DONE-'+str(loop)] = 2

def to_DB_clear(loop):
    global ora
    try:
        #SQL = "update cmmac set synctime=trunc(sysdate,'MI') where companyno='%s' and cmmac='%s'" % (status_arr['SO-'+str(loop)], status_arr['MAC-'+str(loop)])
        SQL = "update cmmac set synctime=trunc(sysdate,'MI'),status=-2,rxpwr=null,rxpwr2=null,cm_rxpwr=null,cm_txpwr=null,cm_txpwr2=null,dl_snr=null,ul_snr=null,ul_snr2=null,cm_t3=null,cm_t4=null,cm_config_file=null,ip=null where companyno='%s' and cmmac='%s'" % (status_arr['SO-'+str(loop)], status_arr['MAC-'+str(loop)])
        print str(loop) + ': ' + SQL
        try:
            ora.execone(SQL)
            ora.commit()
        except Exception, msg:
            nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
            print '['+nowdate+']:'+str(msg)
    except Exception, msg:
        nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
        print '['+nowdate+']:'+str(msg)

#ora_coss = ORA('coss/coss@nmsdb')
ora = ORA('nms@cnis')
if not ora.db:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '[' + nowdate + ']: Unable to connect to server [CNIS]'
    sys.exit(0)


# Get OID
SQL = "select name,oid from snmp_mib where \
       name in ('docsIfDownChannelPower.3','docsIfSigQSignalNoise.3','docsIfCmStatusTxPower.2','docsIfCmStatusT3Timeouts.2','docsIfCmStatusT4Timeouts.2', \
                'CmConfigFile','docsIfCmtsCmStatusIpAddress','docsIfCmtsCmStatusRxPower','docsIfCmtsCmStatusValue','docsIfCmtsCmStatusSignalNoise', \
                'docsIf3CmStatusUsTxPower','docsIf3CmtsCmUsStatusRxPower','docsIf3CmtsCmUsStatusSignalNoise')"
rst = ora.execall(SQL)
if rst is not None and len(rst)>0:
    for aw in rst:
        try:
            xname = aw[0]
            xoid = aw[1]
            snmp_oid[xname] = xoid
        except Exception, msg:
            nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
            print '['+nowdate+']:'+str(msg)
else:
    print "Error: SNMP_MIB is empty"
    if ora.db:
        ora.se_close()
    sys.exit(0)


while 1:
    #cmtssql = "select companyno,cmts_id,cmmac,cmts_ip,snmp_ro,idx,cmip from (select a.companyno,a.cmts_id,a.cmmac,b.ip cmts_ip,b.snmp_ro,a.idx,a.ip cmip from CMMAC a,CMTS b where a.cmts_id=b.cmts_id and (a.synctime<sysdate-0.8 or a.synctime is null) and a.synctime>sysdate-3 order by a.status desc,a.synctime) where rownum<251 order by cmmac"
    #cmtssql = "select companyno,cmts_id,cmmac,cmts_ip,snmp_ro,idx,cmip from (select a.companyno,a.cmts_id,a.cmmac,b.ip cmts_ip,b.snmp_ro,a.idx,a.ip cmip from CMMAC a,CMTS b where a.cmts_id=b.cmts_id and a.companyno in ('101','103','104','300','701','500') and (a.synctime<sysdate-0.8 or a.synctime is null) and a.synctime>sysdate-3 order by a.status desc,a.synctime) where rownum<251 order by cmmac"
    cmtssql = "select companyno,cmts_id,cmmac,cmts_ip,snmp_ro,idx,synctime from ( \
                 select a.companyno,a.cmts_id,a.cmmac,b.ip cmts_ip,b.snmp_ro,a.idx,a.synctime from CMMAC a,CMTS b where a.cmts_id=b.cmts_id and \
                 a.companyno in ('101','103','104','300','701','500') and a.idx > 0 and (a.synctime<sysdate-8/24 or a.synctime is null) and a.updatetime >= sysdate-7 and b.stopyn='N' order by a.synctime \
               ) where rownum <= 250"
    rs1 = ora.execall(cmtssql)
    reclen = len(rs1)
    mloop = 0
    if rs1 is not None and reclen>0:
        for aw in rs1:
            try:
                so = aw[0]
                cmts_id  = aw[1]
                cmmac = aw[2]
                cmts_ip  = aw[3]
                cmts_snmp = aw[4]
                cm_idx  = int(aw[5])
                print str(mloop) +': ' + so, cmmac, cmts_id, cm_idx
            except:
                continue
            status_arr['STATUS-'+str(mloop)] = None
            status_arr['SO-'+str(mloop)] = so
            status_arr['CMTS-'+str(mloop)] = cmts_id
            status_arr['MAC-'+str(mloop)] = cmmac
            status_arr['IP-'+str(mloop)] = cmts_ip
            status_arr['SNMP-'+str(mloop)] = cmts_snmp
            status_arr['DONE-'+str(mloop)] = 0
            thread_arr[mloop] = threading.Thread(target = query_status, args = (mloop, cm_idx, cmts_ip, cmts_snmp))
            thread_arr[mloop].start()
            mloop = mloop+1
        sys.stdout.flush()
    else:
        break

    time.sleep(2)
    check_loop = 0
    while mloop>0:
        check_cnt = 0
        i = 0
        while i<mloop:
            if status_arr['DONE-'+str(i)]==1:
                to_DB(i)
            if status_arr['DONE-'+str(i)]==2:
                check_cnt = check_cnt+1
            i = i+1
        if check_cnt>=mloop:
            print 'All Done ...'
            break
        check_loop = check_loop+1
        if check_loop>5:
            print 'Timeout ...'
            i = 0
            while i<mloop:
                if status_arr['DONE-'+str(i)]==1:
                    to_DB(i)
                elif status_arr['DONE-'+str(i)]==0:
                    to_DB_clear(i)
                i = i+1
            break
        sys.stdout.flush()
        time.sleep(3)
    sys.stdout.flush()
    #break

if ora.db:
    ora.se_close()
sys.exit(0)
