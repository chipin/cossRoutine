#!/usr/bin/env python
# -*- coding: big5 -*-
import sys, re, time, threading
import MySQLdb
from oraclass import ORA
from pysnmpclass import snmpclass

if len(sys.argv) != 2:
    print 'usage:',sys.argv[0],'CompanyNo'
    sys.exit(0)

so = sys.argv[1]
stime = time.time()


def IP_Alarm(oemsno,companyno,ne_id,ifindex,alarm_type,alarm_status,alarm_msg):
    global oracnis, oraoems, oems_arr

    print oemsno,companyno,ne_id,ifindex,alarm_type,alarm_status,alarm_msg

    oems_id = 0
    print ne_id + '-' + str(ifindex) + '-' + alarm_type
    try:
        if oems_arr[ne_id + '-' + str(ifindex) + '-' + alarm_type] is not None:
            oems_id = oems_arr[ne_id + '-' + str(ifindex) + '-' + alarm_type]
    except:
        pass

    print 'oems_id:',oems_id


    alarm_reaon = '流量異常'
    if alarm_type == 'IN_MAX':
        alarm_reaon = alarm_reaon + '(RX高標)'
    elif alarm_type == 'IN_MIN':
        alarm_reaon = alarm_reaon + '(RX低標)'
    elif alarm_type == 'IN_INC':
        alarm_reaon = alarm_reaon + '(RX漲幅)'
    elif alarm_type == 'IN_DEC':
        alarm_reaon = alarm_reaon + '(RX跌幅)'
    elif alarm_type == 'OUT_MAX':
        alarm_reaon = alarm_reaon + '(TX高標)'
    elif alarm_type == 'OUT_MIN':
        alarm_reaon = alarm_reaon + '(TX低標)'
    elif alarm_type == 'OUT_INC':
        alarm_reaon = alarm_reaon + '(TX漲幅)'
    elif alarm_type == 'OUT_DEC':
        alarm_reaon = alarm_reaon + '(TX跌幅)'

    alarm_msg = alarm_msg + '(測試件,勿理會)'

    if alarm_status == 1:
        alarm_msg = '[告警]' + alarm_msg
        if oems_id > 0: # 持續異常
            updsql = "insert into oems_tickets_log (sid,status_date,orig_status,status,descr,account) values ('%d',sysdate,'5120','5120','%s','IPMONv2')" % (oems_id,alarm_msg)
            print updsql
            try:
                oraoems.execone(updsql)
            except:
                print 'Exception: Unable to insert OEMS_TICKETS_LOG'
        else: # 初次異常
            sid = 0
            updsql = "begin insert into oems_tickets_main (status,type,subtype,reason,descr,create_date,operator,account,normal_flag,impact_list) values ('5120',3111,311109,'%s','%s',sysdate,'%s','IPMONv2','A','%s-%s') return to_char(sid) into :1 ; end;" % (alarm_reaon,alarm_msg,oemsno,ne_id,ifindex)
            print updsql
            try:
                oems_sid_ary = oraoems.db.BindingArray(1,12,'SQLT_STR')
                oraoems.c.execute(updsql, oems_sid_ary)
                sid = int(oems_sid_ary[0])
            except:
                print 'Exception: Unable to insert OEMS_TICKETS_MAIN'

            if sid > 0:
                updsql = "insert into oems_tickets_log (sid,status_date,orig_status,status,descr,account) values ('%d',sysdate,'5120','5120','%s','IPMONv2')" % (sid,alarm_msg)
                print updsql
                try:
                    oraoems.execone(updsql)
                except:
                    print 'Exception: Unable to insert OEMS_TICKETS_LOG'

                updsql = "insert into ipif_alarm (companyno,ne_id,ifindex,type,errortime,oems_id) values ('%s','%s',%d,'%s',sysdate,%d)" % (companyno,ne_id,ifindex,alarm_type,sid)
                print updsql
                try:
                    oracnis.execone(updsql)
                except:
                    print 'Exception: Unable to update IPIF_ALARM'
    else:
        alarm_msg = '[解除]' + alarm_msg
        if oems_id > 0: # 恢復正常
            updsql = "insert into oems_tickets_log (sid,status_date,orig_status,status,descr,account) values ('%d',sysdate,'5120','5120','%s','IPMONv2')" % (oems_id,alarm_msg)
            print updsql
            try:
                oraoems.execone(updsql)
            except:
                print 'Exception: Unable to insert OEMS_TICKETS_LOG'

            updsql = "delete from ipif_alarm where companyno='%s' and ne_id = '%s' and ifindex = %d and type = '%s'" % (companyno,ne_id,ifindex,alarm_type)
            print updsql
            try:
                oracnis.execone(updsql)
            except:
                print 'Exception: Unable to update IPIF_ALARM'
        else: # 一切正常
            pass

    oracnis.commit()
    oraoems.commit()


while 1:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+'] start' + "\n"

    print 'start: connect oracle'
    oracnis = ORA('nms@cnis')
    if not oracnis.db:
        print 'Error: Unable to connect to server [CNIS]'
        #sys.exit(0)
        break
    print 'end: connect oracle'

    print 'start: query oracle'
    server_ip = ''
    qry_sql = "select server_ip from so where companyno='%s'" % (so)
    rs1 = oracnis.execall(qry_sql)
    if rs1 is not None and len(rs1) > 0:
        for aw in rs1:
            server_ip = aw[0]
            break
    print 'end: query oracle'

    if len(server_ip) == 0:
        print 'Error: Unable to get QOS Server IP [CNIS]'
        #sys.exit(0)
        break

    print 'start: connect mysql'
    try:
        mysqldb = MySQLdb.connect(host="%s" % (server_ip), user="root", passwd="newom123", db="cmdb_%s" % (so))
        mysqlcur = mysqldb.cursor()
    except Exception, msg:
        print 'Error: Unable to connect to server',server_ip,'[MYSQL]'
        #sys.exit(0)
        break
    print 'end: connect mysql'

    oraoems = ORA('oems@kbro_nmsdb')
    if not oraoems.db:
        print 'Error: Unable to connect to server [OEMS]'
        #sys.exit(0)
        break

    oems_arr = {}
    qry_sql = "select ne_id,ifindex,type,oems_id from ipif_alarm where companyno='%s' and type is not null and oems_id > 0 order by ne_id,ifindex,type" % (so)
    print qry_sql
    rs1 = oracnis.execall(qry_sql)
    if rs1 is not None and len(rs1) > 0:
        for aw in rs1:
            xne = aw[0] + '-' + str(int(aw[1])) + '-' + aw[2]
            oems_arr[xne] = int(aw[3])
    print 'OEMS_ID:',oems_arr

    ip_ne = []
    qry_sql = " \
    select z.shortname,z.oemsno,a.companyno,a.ne_id,a.ifindex, \
    case \
      when b.ifdescr is not null then b.ifdescr \
      when c.ifdescr is not null then c.ifdescr \
      when d.ifdescr is not null then d.ifdescr \
    else NULL end ifdescr, \
    a.k_max_in,a.k_min_in,a.k_increase_in,a.k_decrease_in,a.k_max_out,a.k_min_out,a.k_increase_out,a.k_decrease_out \
    from ipif_kpi a \
    left join ip_ne_if b on b.companyno=a.companyno and b.ne_id=a.ne_id and b.ifindex=a.ifindex and b.stopyn='N' \
    left join cmts_if c on c.companyno=a.companyno and c.cmts_id=a.ne_id and c.ifindex=a.ifindex and c.stopyn='N' \
    left join optics_if d on d.companyno=a.companyno and d.optics_id=a.ne_id and d.ifindex=a.ifindex and d.stopyn='N' \
    inner join so z on z.companyno=a.companyno \
    where a.companyno='%s' \
    and (a.k_max_in > 0 or a.k_min_in > 0 or a.k_increase_in > 0 or a.k_decrease_in > 0 or a.k_max_out > 0 or a.k_min_out > 0 or a.k_increase_out > 0 or a.k_decrease_out > 0) \
    order by a.companyno,a.ne_id,a.ifindex" % (so);
    print qry_sql
    ip_ne = oracnis.execall(qry_sql)
    if ip_ne is not None and len(ip_ne) > 0:
        pass
    else:
        print "Error: IPIF_KPI is empty"
        #sys.exit(0)
        break

    #print ip_ne,len(ip_ne)

    for xx in range(len(ip_ne)):
        soname = ip_ne[xx][0]
        oemsno = ip_ne[xx][1]
        companyno = ip_ne[xx][2]
        ne_id = ip_ne[xx][3]
        ifindex = int(ip_ne[xx][4])
        ifdescr = ip_ne[xx][5]
        k_max_in = ip_ne[xx][6]
        if k_max_in is not None and k_max_in != '':
            k_max_in = int(k_max_in)
        k_min_in = ip_ne[xx][7]
        if k_min_in is not None and k_min_in != '':
            k_min_in = int(k_min_in)
        k_increase_in = ip_ne[xx][8]
        if k_increase_in is not None and k_increase_in != '':
            k_increase_in = int(k_increase_in)
        k_decrease_in = ip_ne[xx][9]
        if k_decrease_in is not None and k_decrease_in != '':
            k_decrease_in = int(k_decrease_in)
        k_max_out = ip_ne[xx][10]
        if k_max_out is not None and k_max_out != '':
            k_max_out = int(k_max_out)
        k_min_out = ip_ne[xx][11]
        if k_min_out is not None and k_min_out != '':
            k_min_out = int(k_min_out)
        k_increase_out = ip_ne[xx][12]
        if k_increase_out is not None and k_increase_out != '':
            k_increase_out = int(k_increase_out)
        k_decrease_out = ip_ne[xx][13]
        if k_decrease_out is not None and k_decrease_out != '':
            k_decrease_out = int(k_decrease_out)

        print soname,oemsno,companyno,ne_id,ifindex,ifdescr,'IN_MAX:',k_max_in,'IN_MIN:',k_min_in,'IN_INC:',k_increase_in,'IN_DEC:',k_decrease_in,'OUT_MAX:',k_max_out,'OUT_MIN:',k_min_out,'OUT_INC:',k_increase_out,'OUT_DEC:',k_decrease_out

        mtime = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time()-(60*20)))
        stime1 = stime2 = stime3 = time1 = time2 = time3 = inoctets1 = inoctets2 = inoctets3 = outoctets1 = outoctets2 = outoctets3 = 0
        inbps1 = outbps1 = inbps2 = outbps2 = 0

        qry_sql = "select ne_id,ifidx,updatetime,unix_timestamp(updatetime),HCInOctets,HCOutOctets,InOctets,OutOctets from ipif_qos where updatetime >= '%s' and ne_id='%s' and ifidx=%d order by updatetime desc limit 3" % (mtime, ne_id, ifindex)
        print qry_sql
        mysqlcur.execute(qry_sql)
        result = mysqlcur.fetchall()
        if result is not None and len(result) > 0:
            i = 0
            for aw in result:
                stimex = aw[2]

                timex = aw[3]
                if timex is not None and timex != '':
                    timex = int(timex)
                else:
                    timex = 0

                inx = aw[4]
                if inx is not None and inx != '':
                    inx = int(inx)
                else:
                    inx = 0

                outx = aw[5]
                if outx is not None and outx != '':
                    outx = int(outx)
                else:
                    outx = 0

                if i == 0:
                    stime1 = stimex
                    time1 = timex
                    inoctets1 = inx
                    outoctets1 = outx
                elif i == 1:
                    stime2 = stimex
                    time2 = timex
                    inoctets2 = inx
                    outoctets2 = outx
                else:
                    stime3 = stimex
                    time3 = timex
                    inoctets3 = inx
                    outoctets3 = outx

                i = i + 1
        print '近三次數據(time,in,out):',stime1,time1,inoctets1,outoctets1,':',stime2,time2,inoctets2,outoctets2,':',stime3,time3,inoctets3,outoctets3

        if time1 == 0:
            alarm_msg = "%s設備:%s %s無法取回流量數據" % (soname,ne_id,ifdescr)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'NODATA',1,alarm_msg)
            continue

        try:
            if oems_arr[ne_id + '-' + str(ifindex) + '-NODATA'] is not None:
                alarm_msg = "%s設備:%s %s已可取回流量數據" % (soname,ne_id,ifdescr)
                IP_Alarm(oemsno,companyno,ne_id,ifindex,'NODATA',0,alarm_msg)
        except:
            pass

        if time1 > 0 and time2 > 0 and inoctets1 > 0 and inoctets2 >= 0 and inoctets1 > inoctets2:
            inbps1 = ((inoctets1-inoctets2)*8)/(time1-time2)
        if time1 > 0 and time2 > 0 and outoctets1 > 0 and outoctets2 >= 0 and outoctets1 > outoctets2:
            outbps1 = ((outoctets1-outoctets2)*8)/(time1-time2)
        if time2 > 0 and time3 > 0 and inoctets2 > 0 and inoctets3 >= 0 and inoctets2 > inoctets3:
            inbps2 = ((inoctets2-inoctets3)*8)/(time2-time3)
        if time2 > 0 and time3 > 0 and outoctets2 > 0 and outoctets3 >= 0 and outoctets2 > outoctets3:
            outbps2 = ((outoctets2-outoctets3)*8)/(time2-time3)
        print '近二次流速(bps,in,out):',inbps1,outbps1,':',inbps2,outbps2

        if k_max_in > 0:
            status = 0
            if inbps1 >= k_max_in and inbps1 > 0:
                status = 1
            alarm_msg = "%s設備:%s %s, RX高標設定:%dbps, 現行流量:%dbps" % (soname,ne_id,ifdescr,k_max_in,inbps1)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'IN_MAX',status,alarm_msg)

        if k_min_in > 0:
            status = 0
            if k_min_in >= inbps1 and inbps1 > 0:
                status = 1
            alarm_msg = "%s設備:%s %s, RX低標設定:%dbps, 現行流量:%dbps" % (soname,ne_id,ifdescr,k_min_in,inbps1)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'IN_MIN',status,alarm_msg)

        if k_increase_in > 0:
            status = 0
            inrate = 0
            if inbps1 > 0 and inbps2 > 0 and inbps1 > inbps2:
                inrate = round(((inbps1-inbps2)/float(inbps2))*100,1)
                if inrate >= k_increase_in:
                    status = 1
            alarm_msg = "%s設備:%s %s, RX漲幅設定:%d%%, 現行流量:%dbps, 上次流量:%dbps, 漲幅:%.1f%%" % (soname,ne_id,ifdescr,k_increase_in,inbps1,inbps2,inrate)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'IN_INC',status,alarm_msg)

        if k_decrease_in > 0:
            status = 0
            inrate = 0
            if inbps1 > 0 and inbps2 > 0 and inbps2 > inbps1:
                inrate = round(((inbps2-inbps1)/float(inbps2))*100,1)
                if inrate >= k_decrease_in:
                    status = 1
            alarm_msg = "%s設備:%s %s, RX跌幅設定:%d%%, 現行流量:%dbps, 上次流量:%dbps, 跌幅:%.1f%%" % (soname,ne_id,ifdescr,k_decrease_in,inbps1,inbps2,inrate)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'IN_DEC',status,alarm_msg)

        if k_max_out > 0:
            status = 0
            if outbps1 >= k_max_out and outbps1 > 0:
                status = 1
            alarm_msg = "%s設備:%s %s, TX高標設定:%dbps, 現行流量:%dbps" % (soname,ne_id,ifdescr,k_max_out,outbps1)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'OUT_MAX',status,alarm_msg)

        if k_min_out > 0:
            status = 0
            if k_min_out >= outbps1 and outbps1 > 0:
                status = 1
            alarm_msg = "%s設備:%s %s, TX低標設定:%dbps, 現行流量:%dbps" % (soname,ne_id,ifdescr,k_min_out,outbps1)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'OUT_MIN',status,alarm_msg)

        if k_increase_out > 0:
            status = 0
            outrate = 0
            if outbps1 > 0 and outbps2 > 0 and outbps1 > outbps2:
                outrate = round(((outbps1-outbps2)/float(outbps2))*100,1)
                if outrate >= k_increase_out:
                    status = 1
            alarm_msg = "%s設備:%s %s, TX漲幅設定:%d%%, 現行流量:%dbps, 上次流量:%dbps, 漲幅:%.1f%%" % (soname,ne_id,ifdescr,k_increase_out,outbps1,outbps2,outrate)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'OUT_INC',status,alarm_msg)

        if k_decrease_out > 0:
            status = 0
            outrate = 0
            if outbps1 > 0 and outbps2 > 0 and outbps2 > outbps1:
                outrate = round(((outbps2-outbps1)/float(outbps2))*100,1)
                if outrate >= k_decrease_out:
                    status = 1
            alarm_msg = "%s設備:%s %s, TX跌幅設定:%d%%, 現行流量:%dbps, 上次流量:%dbps, 跌幅:%.1f%%" % (soname,ne_id,ifdescr,k_decrease_out,outbps1,outbps2,outrate)
            IP_Alarm(oemsno,companyno,ne_id,ifindex,'OUT_DEC',status,alarm_msg)

    sys.stdout.flush()
    if mysqldb is not None:
        mysqldb.close()
        mysqldb = None
    if oracnis is not None:
        oracnis.se_close()
        oracnis = None
    if oraoems is not None:
        oraoems.se_close()
        oraoems = None
    etime = time.time()
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print "[%s] end (total: %d)" % (nowdate, etime-stime)
    sys.stdout.flush()

    break

    while etime-stime<300:
        time.sleep(5)
        etime = time.time()
    stime = time.time()

if mysqldb is not None:
    mysqldb.close()
if oracnis is not None:
    oracnis.se_close()
if oraoems is not None:
    oraoems.se_close()
sys.exit(0)

