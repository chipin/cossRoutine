                region = ''
            road = curarr[ii][7]
            addrname = curarr[ii][8]
            nodeno = curarr[ii][9]
            link = curarr[ii][10]
            billpkg = curarr[ii][11]
            billitem = curarr[ii][12]
            swversion = curarr[ii][13]
            swversion2 = curarr[ii][14]
