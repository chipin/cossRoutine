                    select m.companyno,m.subsid,max(m.recvno) recvno from ms0216 m with (nolock) \
                    inner join ms0200 n with (nolock) on n.companyno=m.companyno and n.subsid=m.subsid and substring(n.custstatus,1,1) in ('0','1','2','6','7','8','9','A','B') and n.servicename in ('2 CM') and n.singlesn is not null and n.singlesn <> '' \
