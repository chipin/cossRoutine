#!/usr/bin/env python
# -*- coding: big5 -*-
import sys
import os
import string
import time
import binascii
from pysnmpclass import snmpclass
from oraclass import ORA

pre_exec_time = 0
agent = snmpclass(version='v2c',ptimeout=1,pretries=3,debug=0)

def query_status(ycmtsid, yip, ymodel, ycomm, yoid):
    global cmts_oid, agent
    print yoid
    print ycmtsid, yip, ymodel, ycomm

    yresult = {}

    try:
        for oname in yoid:
            try:
                tmp_mib = cmts_oid['%s-X' % (oname)]
            except:
                try:
                    tmp_mib = cmts_oid['%s-%s' % (oname, ymodel)]
                except:
                    continue
            rets = agent.snmpwalk([yip, '-c', ycomm, tmp_mib])
            i = 0
            lens = len(rets)
            while i<lens:
                zid = rets[i][0].replace(tmp_mib+'.','')
                zvalue = rets[i][1]

                if oname in ['ifIndex']:
                    yresult['%s-%s-%d' % (ycmtsid, oname, i)] = zid
                elif oname in ['CmPtr']:
                    yresult['%s-%s-%d' % (ycmtsid, oname, i)] = zid
                    yresult['%s-%s-%d' % (ycmtsid, 'CmPtrIdx', i)] = zvalue
                else:
                    yresult['%s-%s-%s' % (ycmtsid, oname, zid)] = zvalue

                i = i+1
                #print ycmtsid,oname,zid,zvalue
            print "%s (%s %s) -> %d" % (ycmtsid, oname, tmp_mib, lens)

            if oname in ['ifIndex','CmPtr']:
                yresult['%s-%s-LEN' % (ycmtsid, oname)] = lens
            sys.stdout.flush()
    except Exception, msg:
        nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
        print '['+nowdate+']:'+str(msg)

    return yresult


while 1:
    cmts_oid = {}
    oid_name = []
    oid_name2 = ['ifIndex','DSCmActive','DSCmTotal','USCmActive','USCmTotal']

    ora = ORA('nms@cnis')

    if not ora.db:
        print 'sleep 60secs ...'
        time.sleep(60)
        continue

    # Get CMTS OID
    SQL = "select name,upper(model) model,oid \
           from nms.snmp_oid \
           where name in ('CPU','Temperature','SysDescr','ifIndex','ifDescr','ifAdminStatus','ifOperStatus','ifSpeed', \
                          'CmPtr','CmStatusUSIndex','CmStatusDSIndex','CmStatusIP','CmStatus','DSCmActive','DSCmTotal','USCmActive','USCmTotal', \
                          'DSId','DSFrequency','DSWidth','DSModulation','DSInterleave','USId','USFrequency','USWidth','USModulation')"
    rst = ora.execall(SQL)
    if rst is not None and len(rst)>0:
        for aw in rst:
            try:
                xname = aw[0]
                xmodel = aw[1]
                xoid = aw[2]
                if xmodel is None:
                    xmodel = 'X'
                cmts_oid[xname+'-'+xmodel] = xoid

                if xname in ['CPU','Temperature','SysDescr','DSCmActive','DSCmTotal','USCmActive','USCmTotal']:
                    continue
                if xname not in oid_name:
                    oid_name.append(xname)
            except Exception, msg:
                nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
                print '['+nowdate+']:'+str(msg)
    else:
        print "Error: SNMP_OID is empty"
        if ora.db:
            ora.se_close()
        print 'sleep 60secs ...'
        time.sleep(60)
        continue

    #print 'oid_name =',oid_name
    #print 'oid_name2 =',oid_name2
    #sys.stdout.flush()

    cmts_ip={}
    cmts_id={}
    cmts_so={}
    cmts_comm={}
    cmts_mflag={}
    cmts_model={}
    cmts_cnt = 0

    cmtssql = "select a.companyno,a.cmts_id,a.ip,a.snmp_ro,a.mflag, \
               case \
                 when upper(b.maker||b.model) like '%%UBR%%' then 'UBR' when upper(b.maker||b.model) like '%%CASA%%' then 'CASA' \
                 when upper(b.maker||b.model) like '%%CUDA%%' then 'CUDA' when upper(b.maker||b.model) like '%%MOTO%%' then 'MOTO' else NULL end type \
               from cmts a \
               inner join sys_object b on b.ne_id=substr(a.cmts_id,-8,4) and b.stopyn='N' \
               where \
               a.ip is not NULL and a.snmp_ro is not NULL and a.stopyn='N' and a.mflag > 0 \
               order by a.companyno,a.cmts_id asc"
    #cmtssql = "select a.companyno,a.cmts_id,a.ip,a.snmp_ro,a.mflag, \
    #           case \
    #             when upper(b.maker||b.model) like '%%UBR%%' then 'UBR' when upper(b.maker||b.model) like '%%CASA%%' then 'CASA' \
    #             when upper(b.maker||b.model) like '%%CUDA%%' then 'CUDA' when upper(b.maker||b.model) like '%%MOTO%%' then 'MOTO' else NULL end model \
    #           from cmts a \
    #           inner join sys_object b on b.ne_id=substr(a.cmts_id,-8,4) and b.stopyn='N' \
    #           where \
    #           a.cmts_id in ('XJ_CC02_001','DY_CB01_001','GS0_CK02_001','PL0_CM01_001') and \
    #           a.ip is not NULL and a.snmp_ro is not NULL and a.stopyn='N' and a.mflag > 0 \
    #           order by a.companyno,a.cmts_id asc"
    rs1 = ora.execall(cmtssql)
    if rs1 is not None and len(rs1)>0:
        for aw in rs1:
            cmts_so[cmts_cnt] = aw[0]
            cmts_id[cmts_cnt] = aw[1]
            cmts_ip[cmts_cnt] = aw[2]
            cmts_comm[cmts_cnt] = aw[3]
            cmts_mflag[cmts_cnt] = aw[4]
            cmts_model[cmts_cnt] = aw[5]
            cmts_cnt = cmts_cnt+1

    cmts_idx = 0
    while cmts_idx<cmts_cnt:
        try:
            xso = cmts_so[cmts_idx]
            xcmtsid = cmts_id[cmts_idx]
            xIP = cmts_ip[cmts_idx]
            xcomm = cmts_comm[cmts_idx]
            xmflag = cmts_mflag[cmts_idx]
            xmodel = cmts_model[cmts_idx]

            nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
            print '['+nowdate+']', xso, xcmtsid, xIP, xcomm, xmodel

            truncsql = "update cmts_if set synctime=NULL where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
            ora.execone(truncsql)
            ora.commit()

            if xmflag==1:
                truncsql = "update cmmac set status=-1,updatetime=sysdate,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
                ora.execone(truncsql)
                ora.commit()

            result = {}
            result = query_status(xcmtsid, xIP, xmodel, xcomm, oid_name)
            #print 'result=',result

            ifnum = 0
            if result['%s-ifIndex-LEN' % (xcmtsid)] > 0:
                ifnum = result['%s-ifIndex-LEN' % (xcmtsid)]

            i = 0
            while i<ifnum:
                xid = result[xcmtsid+'-ifIndex-'+str(i)]

                try:
                    chid = int(result[xcmtsid+'-DSId-'+str(xid)])
                except:
                    try:
                        chid = int(result[xcmtsid+'-USId-'+str(xid)])
                    except:
                        chid = -1
                try:
                    chfreq = int(result[xcmtsid+'-DSFrequency-'+str(xid)])
                except:
                    try:
                        chfreq = int(result[xcmtsid+'-USFrequency-'+str(xid)])
                    except:
                        chfreq = -1
                try:
                    chbw = int(result[xcmtsid+'-DSWidth-'+str(xid)])
                except:
                    try:
                        chbw = int(result[xcmtsid+'-USWidth-'+str(xid)])
                    except:
                        chbw = -1
                try:
                    chmodf = int(result[xcmtsid+'-DSModulation-'+str(xid)])
                except:
                    try:
                        chmodf = int(result[xcmtsid+'-USModulation-'+str(xid)])
                    except:
                        chmodf = -1
                try:
                    chinter = int(result[xcmtsid+'-DSInterleave-'+str(xid)])
                except:
                    chinter = -1

                SQL = "select ifindex from cmts_if where cmts_id='%s' and ifindex=%d" % (xcmtsid, int(xid))
                rs2 = ora.execall(SQL)
                reclen = len(rs2)
                if rs2 is not None and reclen>0:
                    SQL = "update cmts_if set ifdescr='%s',ifadminstatus='%s',ifoperstatus='%s',ifspeed=%d,ch_id=%d,ch_freq=%d,ch_bw=%d,ch_mod=%d,ch_inter=%d,synctime=sysdate,cmactive=null,cmtotal=null where companyno='%s' and cmts_id='%s' and ifindex=%d" % (result[xcmtsid+'-ifDescr-'+str(xid)], result[xcmtsid+'-ifAdminStatus-'+str(xid)], result[xcmtsid+'-ifOperStatus-'+str(xid)], int(result[xcmtsid+'-ifSpeed-'+str(xid)]), chid,chfreq,chbw,chmodf,chinter,xso,xcmtsid,int(xid))
                else:
                    SQL = "insert into cmts_if (companyno,cmts_id,ifindex,ifdescr,ifspeed,ifadminstatus,ifoperstatus,ch_id,ch_freq,ch_bw,ch_mod,ch_inter,synctime) values ('%s','%s',%d,'%s',%d,%d,%d,%d,%d,%d,%d,%d,sysdate)" % (xso, xcmtsid, int(xid), result[xcmtsid+'-ifDescr-'+str(xid)], int(result[xcmtsid+'-ifSpeed-'+str(xid)]), result[xcmtsid+'-ifAdminStatus-'+str(xid)], result[xcmtsid+'-ifOperStatus-'+str(xid)], chid,chfreq,chbw,chmodf,chinter)
                print i, '/', ifnum, ':', SQL
                ora.execone(SQL)
                i = i+1
                if (i%50)==0:
                    ora.commit()
                    sys.stdout.flush()
            truncsql = "delete from cmts_if where companyno='%s' and cmts_id='%s' and synctime is NULL" % (xso, xcmtsid)
            ora.execone(truncsql)
            ora.commit()

        except Exception, detail:
            print '['+nowdate+']', xso, xcmtsid, detail
            SQL = "update cmts set mflag=-1,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
            ora.execone(SQL)
            ora.commit()
            cmts_idx = cmts_idx+1
            continue

        sys.stdout.flush()

        if xmflag==1:
            try:
                macnum = 0
                if result['%s-CmPtr-LEN' % (xcmtsid)] > 0:
                    macnum = result['%s-CmPtr-LEN' % (xcmtsid)]

                i=0
                while i<macnum:
                    xid = result[xcmtsid+'-CmPtr-'+str(i)]
                    xvalue = result[xcmtsid+'-CmPtrIdx-'+str(i)]
                    mac = xid.split('.')
                    cmmac = "%.2X%.2X%.2X%.2X%.2X%.2X" % (int(mac[0]), int(mac[1]), int(mac[2]), int(mac[3]), int(mac[4]), int(mac[5]))

                    try:
                        xuplnkidx = result[xcmtsid+'-CmStatusUSIndex-'+str(xvalue)]
                    except Exception, detail:
                        xuplnkidx = -1
                    try:
                        xdownlnkidx = result[xcmtsid+'-CmStatusDSIndex-'+str(xvalue)]
                    except Exception, detail:
                        xdownlnkidx = -1
                    try:
                        cmip = result[xcmtsid+'-CmStatusIP-'+str(xvalue)]
                    except Exception, detail:
                        cmip = ''
                    try:
                        status = result[xcmtsid+'-CmStatus-'+str(xvalue)]
                    except Exception, detail:
                        status = -1

                    SQL = "select idx from cmmac where cmmac='%s'" % (cmmac)
                    rs2 = ora.execall(SQL)
                    reclen = len(rs2)
                    if rs2 is not None and reclen>0:
                        SQL = "update cmmac set idx=%d,ip='%s',uplink_idx=%d,dllink_idx=%d,status=%d,updatetime=sysdate,companyno='%s',cmts_id='%s' where cmmac='%s'" % (xvalue, cmip, xuplnkidx, xdownlnkidx, status, xso, xcmtsid, cmmac)
                    else:
                        SQL = "insert into cmmac (companyno,cmts_id,cmmac,idx,ip,uplink_idx,dllink_idx,status,updatetime,synctime) values ('%s','%s','%s',%d, '%s',%d,%d,%d,sysdate,sysdate-0.8)" % (xso, xcmtsid, cmmac, xvalue, cmip, xuplnkidx, xdownlnkidx, status)
                    print i, '/', macnum, ':', SQL
                    ora.execone(SQL)
                    i = i+1
                    if (i%50)==0:
                        ora.commit()
                        sys.stdout.flush()
            except Exception, detail:
                print '['+nowdate+']', xso, xcmtsid, detail
                SQL = "update cmts set mflag=-1,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
                ora.execone(SQL)

        cmts_descr = ''
        rets = agent.snmpget([xIP, '-c', xcomm, cmts_oid['SysDescr-X']])
        if rets is not None and rets[0][1]!='':
            cmts_descr = rets[0][1]
        print 'SysDescr:', cmts_descr

        SQL = "update cmts set mflag=0,sys_descr='%s',synctime=sysdate where companyno='%s' and cmts_id='%s'" % (cmts_descr, xso, xcmtsid)
        ora.execone(SQL)
        ora.commit()
        print '%s %s is complete ...' % (xso, xcmtsid)
        sys.stdout.flush()
        cmts_idx = cmts_idx+1

    exec_time = int(time.time())

    if exec_time-pre_exec_time>300:
        cmts_ip={}
        cmts_id={}
        cmts_so={}
        cmts_comm={}
        cmts_model={}
        cmts_cnt = 0

        cmtssql = "select a.companyno,a.cmts_id,a.ip,a.snmp_ro, \
                   case \
                     when upper(b.maker||b.model) like '%%UBR%%' then 'UBR' when upper(b.maker||b.model) like '%%CASA%%' then 'CASA' \
                     when upper(b.maker||b.model) like '%%CUDA%%' then 'CUDA' when upper(b.maker||b.model) like '%%MOTO%%' then 'MOTO' else NULL end type \
                   from cmts a \
                   inner join sys_object b on b.ne_id=substr(a.cmts_id,-8,4) and b.stopyn='N' \
                   where \
                   a.ip is not NULL and a.snmp_ro is not NULL and a.stopyn='N' \
                   order by a.companyno,a.cmts_id asc"
        #cmtssql = "select a.companyno,a.cmts_id,a.ip,a.snmp_ro, \
        #           case \
        #             when upper(b.maker||b.model) like '%%UBR%%' then 'UBR' when upper(b.maker||b.model) like '%%CASA%%' then 'CASA' \
        #             when upper(b.maker||b.model) like '%%CUDA%%' then 'CUDA' when upper(b.maker||b.model) like '%%MOTO%%' then 'MOTO' else NULL end type \
        #           from cmts a \
        #           inner join sys_object b on b.ne_id=substr(a.cmts_id,-8,4) and b.stopyn='N' \
        #           where \
        #           a.cmts_id in ('XJ_CC02_001','DY_CB01_001','GS0_CK02_001','PL0_CM01_001') and  \
        #           a.ip is not NULL and a.snmp_ro is not NULL and a.stopyn='N' \
        #           order by a.companyno,a.cmts_id asc"
        rs1 = ora.execall(cmtssql)
        if rs1 is not None and len(rs1)>0:
            for aw in rs1:
                cmts_so[cmts_cnt] = aw[0]
                cmts_id[cmts_cnt] = aw[1]
                cmts_ip[cmts_cnt] = aw[2]
                cmts_comm[cmts_cnt] = aw[3]
                cmts_model[cmts_cnt] = aw[4]
                cmts_cnt = cmts_cnt+1

        cmts_idx = 0
        while cmts_idx<cmts_cnt:
            try:
                xso = cmts_so[cmts_idx]
                xcmtsid = cmts_id[cmts_idx]
                xIP = cmts_ip[cmts_idx]
                xcomm = cmts_comm[cmts_idx]
                xmodel = cmts_model[cmts_idx]

                nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
                print '['+nowdate+']', xso, xcmtsid, xIP, xcomm, xmodel

                result = {}
                result = query_status(xcmtsid, xIP, xmodel, xcomm, oid_name2)
                #print 'result=',result

                ifnum = 0
                if result['%s-ifIndex-LEN' % (xcmtsid)] > 0:
                    ifnum = result['%s-ifIndex-LEN' % (xcmtsid)]
                print ifnum

                i = 0
                j = 0
                t_cmactive = 0
                t_cmtotal = 0
                while i<ifnum:
                    xid = result[xcmtsid+'-ifIndex-'+str(i)]

                    try:
                        cmactive = int(result[xcmtsid+'-DSCmActive-'+str(xid)])
                    except:
                        try:
                            cmactive = int(result[xcmtsid+'-USCmActive-'+str(xid)])
                            t_cmactive = t_cmactive + cmactive
                        except:
                            cmactive = -1
                    try:
                        cmtotal = int(result[xcmtsid+'-DSCmTotal-'+str(xid)])
                    except:
                        try:
                            cmtotal = int(result[xcmtsid+'-USCmTotal-'+str(xid)])
                            t_cmtotal = t_cmtotal + cmtotal
                        except:
                            cmtotal = -1

                    if cmactive >= 0 and cmtotal >= 0:
                        SQL = "select ifindex from cmts_if where cmts_id='%s' and ifindex=%d" % (xcmtsid, int(xid))
                        rs2 = ora.execall(SQL)
                        reclen = len(rs2)
                        if rs2 is not None and reclen>0:
                            SQL = "update cmts_if set cmactive=%d,cmtotal=%d,synctime=sysdate where companyno='%s' and cmts_id='%s' and ifindex=%d" % (cmactive,cmtotal,xso,xcmtsid,int(xid))
                        else:
                            SQL = "insert into cmts_if (companyno,cmts_id,ifindex,cmactive,cmtotal,synctime) values ('%s','%s',%d,%d,%d,sysdate)" % (xso,xcmtsid,int(xid),cmactive,cmtotal)
                        print i, '/', ifnum, ':', SQL
                        ora.execone(SQL)
                        j = j+1
                        if (j%50)==0:
                            ora.commit()
                            sys.stdout.flush()
                    i = i+1

                if j > 0:
                    SQL = "update cmts set cmactive=%d,cmtotal=%d,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (t_cmactive, t_cmtotal, xso, xcmtsid)
                    print SQL
                    ora.execone(SQL)
                    ora.commit()
                    sys.stdout.flush()

                if xmodel=='CASA':
                    temp_div = 10
                elif xmodel=='UBR':
                    temp_div = 1
                else:
                    cmts_idx = cmts_idx+1
                    continue

                cpu_mib = "%s" % (cmts_oid['CPU-'+xmodel])
                temp_mib = "%s" % (cmts_oid['Temperature-'+xmodel])

                rets = agent.snmpget([xIP, '-c', xcomm, cpu_mib])
                if rets is not None and rets[0][1]!='':
                    xcpu = int(rets[0][1])
                else:
                    xcpu = -1

                rets = agent.snmpget([xIP, '-c', xcomm, temp_mib])
                if rets is not None and rets[0][1]!='':
                    xtemp = int(rets[0][1])/temp_div
                else:
                    xtemp = -1

                SQL = "update cmts set cpu=%d,tpt=%d,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xcpu, xtemp, xso, xcmtsid)
                print SQL
                ora.execone(SQL)
                ora.commit()
                sys.stdout.flush()

            except Exception, detail:
                print '['+nowdate+']', xso, xcmtsid, detail

            ora.commit()
            sys.stdout.flush()
            cmts_idx = cmts_idx+1

        pre_exec_time = exec_time
    if ora.db:
        ora.se_close()
    print 'sleep 30secs ...'
    time.sleep(30)
sys.exit(0)
