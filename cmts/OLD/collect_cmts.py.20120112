#!/usr/bin/env python
# -*- coding: big5 -*-
import sys
import os
import string
import time
import binascii
from pysnmpclass import snmpclass
from oraclass import ORA

sysdescr_mib = '.1.3.6.1.2.1.1.1.0'
macidx_mib = '.1.3.6.1.2.1.10.127.1.3.7.1.2'
ifidx_mib = '.1.3.6.1.2.1.10.127.1.3.4.1.2'
iftype_mib = '.1.3.6.1.2.1.2.2.1.3'
ifdescr_mib = '.1.3.6.1.2.1.2.2.1.2'
ifadmin_mib = '.1.3.6.1.2.1.2.2.1.7'
ifoper_mib = '.1.3.6.1.2.1.2.2.1.8'
upsnr_mib = '.1.3.6.1.2.1.10.127.1.3.3.1.13'
macupchnidx = '.1.3.6.1.2.1.10.127.1.3.3.1.5'
macdownchnidx = '.1.3.6.1.2.1.10.127.1.3.3.1.4'
cmipidx = '.1.3.6.1.2.1.10.127.1.3.3.1.3'
macstatusidx = '.1.3.6.1.2.1.10.127.1.3.3.1.9'

ifspeed_mib = '.1.3.6.1.2.1.2.2.1.5'

dl_chid_mib = '.1.3.6.1.2.1.10.127.1.1.1.1.1'
dl_chfreq_mib = '.1.3.6.1.2.1.10.127.1.1.1.1.2'
dl_chbw_mib = '.1.3.6.1.2.1.10.127.1.1.1.1.3'
dl_chmod_mib = '.1.3.6.1.2.1.10.127.1.1.1.1.4'
dl_chinter_mib = '.1.3.6.1.2.1.10.127.1.1.1.1.5'

ul_chid_mib = '.1.3.6.1.2.1.10.127.1.1.2.1.1'
ul_chfreq_mib = '.1.3.6.1.2.1.10.127.1.1.2.1.2'
ul_chbw_mib = '.1.3.6.1.2.1.10.127.1.1.2.1.3'
ul_chmod_mib = '.1.3.6.1.2.1.10.127.1.1.2.1.4'
ul_chinter_mib = '.1.3.6.1.2.1.10.127.1.1.2.1.5'

ubr10k_cpu_mib = '.1.3.6.1.4.1.9.2.1.56.0'
casa_cpu_mib = '.1.3.6.1.4.1.20858.10.13.1.1.1.4.2'

ubr10k_temp_mib = '.1.3.6.1.4.1.9.9.13.1.3.1.3.2'
casa_temp_mib = '.1.3.6.1.2.1.99.1.1.1.4.103'

pre_exec_time = 0

agent = snmpclass(version='v2c',community='public',ptimeout=1,pretries=3)

while 1:
    ora = ORA('nms@cnis')

    if not ora.db:
        time.sleep(60)
        continue

    cmts_ip={}
    cmts_id={}
    cmts_so={}
    cmts_comm={}
    cmts_mflag={}
    cmts_cnt = 0

    cmtssql = "select companyno,cmts_id,ip,snmp_ro,mflag from cmts where stopyn = 'N' and mflag > 0 order by companyno,cmts_id"
    rs1 = ora.execall(cmtssql)
    if rs1 is not None and len(rs1)>0:
        for aw in rs1:
            cmts_so[cmts_cnt] = aw[0]
            cmts_id[cmts_cnt] = aw[1]
            cmts_ip[cmts_cnt] = aw[2]
            cmts_comm[cmts_cnt] = aw[3]
            cmts_mflag[cmts_cnt] = aw[4]
            cmts_cnt = cmts_cnt+1

    #if cmts_cnt<=0:
    #    print 'Continue......'

    cmts_idx = 0
    while cmts_idx<cmts_cnt:
        try:
            result = {}
            nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
            xso = cmts_so[cmts_idx]
            xcmtsid = cmts_id[cmts_idx]
            xIP = cmts_ip[cmts_idx]
            xcomm = cmts_comm[cmts_idx]
            xmflag = cmts_mflag[cmts_idx]

            print '['+nowdate+']',
            print xso, xcmtsid, xIP

            truncsql = "update cmts_if set synctime=NULL where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
            ora.execone(truncsql)
            ora.commit()

            if xmflag==1:
                truncsql = "update cmmac set status=-1,updatetime=sysdate,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
                ora.execone(truncsql)
                ora.commit()

            cmts_descr = ''
            rets = agent.snmpget([xIP, '-c', xcomm, sysdescr_mib])
            if rets is not None and rets[0][1]!='':
                cmts_descr = rets[0][1]
            print sysdescr_mib,'=>',cmts_descr
            sys.stdout.flush()

            print iftype_mib
            iftype_array = agent.snmpbulkwalk([xIP, '-c', xcomm, iftype_mib])
            i=0
            lens=len(iftype_array)
            while i<lens:
                xid = iftype_array[i][0].replace(iftype_mib+'.','')
                xvalue = iftype_array[i][1]
                result[xcmtsid+'-TYPEID-'+str(i)] = xid
                result[xcmtsid+'-TYPEV-'+str(xid)] = xvalue
                i = i+1
            ifnum = i

            print ifdescr_mib
            ifdescr_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ifdescr_mib])
            i=0
            lens=len(ifdescr_array)
            while i<lens:
                xid = ifdescr_array[i][0].replace(ifdescr_mib+'.','')
                xvalue = ifdescr_array[i][1]
                result[xcmtsid+'-DSCRV-'+str(xid)] = xvalue
                i = i+1

            print ifspeed_mib
            ifspeed_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ifspeed_mib])
            i=0
            lens=len(ifspeed_array)
            while i<lens:
                xid = ifspeed_array[i][0].replace(ifspeed_mib+'.','')
                xvalue = ifspeed_array[i][1]
                result[xcmtsid+'-SPEED-'+str(xid)] = xvalue
                i = i+1

            print ifadmin_mib
            ifadmin_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ifadmin_mib])
            i=0
            lens=len(ifadmin_array)
            while i<lens:
                xid = ifadmin_array[i][0].replace(ifadmin_mib+'.','')
                xvalue = ifadmin_array[i][1]
                result[xcmtsid+'-ADMIN-'+str(xid)] = xvalue
                i = i+1

            print ifoper_mib
            ifoper_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ifoper_mib])
            i=0
            lens=len(ifoper_array)
            while i<lens:
                xid = ifoper_array[i][0].replace(ifoper_mib+'.','')
                xvalue = ifoper_array[i][1]
                result[xcmtsid+'-OPER-'+str(xid)] = xvalue
                i = i+1

            print dl_chid_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, dl_chid_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(dl_chid_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-DLCHID-'+str(xid)] = xvalue
                i = i+1

            print dl_chfreq_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, dl_chfreq_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(dl_chfreq_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-DLCHFREQ-'+str(xid)] = xvalue
                i = i+1

            print dl_chbw_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, dl_chbw_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(dl_chbw_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-DLCHBW-'+str(xid)] = xvalue
                i = i+1

            print dl_chmod_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, dl_chmod_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(dl_chmod_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-DLCHMOD-'+str(xid)] = xvalue
                i = i+1

            print dl_chinter_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, dl_chinter_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(dl_chinter_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-DLCHINTER-'+str(xid)] = xvalue
                i = i+1

            print ul_chid_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ul_chid_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(ul_chid_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-ULCHID-'+str(xid)] = xvalue
                i = i+1

            print ul_chfreq_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ul_chfreq_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(ul_chfreq_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-ULCHFREQ-'+str(xid)] = xvalue
                i = i+1

            print ul_chbw_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ul_chbw_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(ul_chbw_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-ULCHBW-'+str(xid)] = xvalue
                i = i+1

            print ul_chmod_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ul_chmod_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(ul_chmod_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-ULCHMOD-'+str(xid)] = xvalue
                i = i+1

            print ul_chinter_mib
            ret_array = agent.snmpbulkwalk([xIP, '-c', xcomm, ul_chinter_mib])
            i=0
            lens=len(ret_array)
            while i<lens:
                xid = ret_array[i][0].replace(ul_chinter_mib+'.','')
                xvalue = ret_array[i][1]
                result[xcmtsid+'-ULCHINTER-'+str(xid)] = xvalue
                i = i+1

            i = 0
            while i<ifnum:
                xid = result[xcmtsid+'-TYPEID-'+str(i)]
                try:
                    chid = int(result[xcmtsid+'-DLCHID-'+str(xid)])
                except:
                    try:
                        chid = int(result[xcmtsid+'-ULCHID-'+str(xid)])
                    except:
                        chid = -1
                try:
                    chfreq = int(result[xcmtsid+'-DLCHFREQ-'+str(xid)])
                except:
                    try:
                        chfreq = int(result[xcmtsid+'-ULCHFREQ-'+str(xid)])
                    except:
                        chfreq = -1
                try:
                    chbw = int(result[xcmtsid+'-DLCHBW-'+str(xid)])
                except:
                    try:
                        chbw = int(result[xcmtsid+'-ULCHBW-'+str(xid)])
                    except:
                        chbw = -1
                try:
                    chmodf = int(result[xcmtsid+'-DLCHMOD-'+str(xid)])
                except:
                    try:
                        chmodf = int(result[xcmtsid+'-ULCHMOD-'+str(xid)])
                    except:
                        chmodf = -1
                try:
                    chinter = int(result[xcmtsid+'-DLCHINTER-'+str(xid)])
                except:
                    try:
                        chinter = int(result[xcmtsid+'-ULCHINTER-'+str(xid)])
                    except:
                        chinter = -1

                SQL = "select ifindex from cmts_if where cmts_id='%s' and ifindex=%d" % (xcmtsid, int(xid))
                rs2 = ora.execall(SQL)
                reclen = len(rs2)
                if rs2 is not None and reclen>0:
                    #SQL = "update cmts_if set type='%s',descr='%s',cmts_ip='%s',admin=%d,operator=%d,ch_id=%d,ch_freq=%d,ch_bw=%d,ch_mod=%d,ch_inter=%d,sync_flag='Y' where cmts_id='%s' and ifidx=%s" % (int(result[xcmtsid+'-TYPEV-'+str(xid)]), result[xcmtsid+'-DSCRV-'+str(xid)], xIP, result[xcmtsid+'-ADMIN-'+str(xid)], result[xcmtsid+'-OPER-'+str(xid)],chid,chfreq,chbw,chmodf,chinter,xcmtsid,xid)
                    SQL = "update cmts_if set ifdescr='%s',ifadminstatus='%s',ifoperstatus='%s',ifspeed=%d,ch_id=%d,ch_freq=%d,ch_bw=%d,ch_mod=%d,ch_inter=%d,synctime=sysdate where companyno='%s' and cmts_id='%s' and ifindex=%d" % (result[xcmtsid+'-DSCRV-'+str(xid)], result[xcmtsid+'-ADMIN-'+str(xid)], result[xcmtsid+'-OPER-'+str(xid)], int(result[xcmtsid+'-SPEED-'+str(xid)]), chid,chfreq,chbw,chmodf,chinter,xso,xcmtsid,int(xid))
                else:
                    SQL = "insert into cmts_if (companyno,cmts_id,ifindex,ifdescr,ifspeed,ifadminstatus,ifoperstatus,ch_id,ch_freq,ch_bw,ch_mod,ch_inter,synctime) values ('%s','%s',%d,'%s',%d,%d,%d,%d,%d,%d,%d,%d,sysdate)" % (xso, xcmtsid, int(xid), result[xcmtsid+'-DSCRV-'+str(xid)], int(result[xcmtsid+'-SPEED-'+str(xid)]), result[xcmtsid+'-ADMIN-'+str(xid)], result[xcmtsid+'-OPER-'+str(xid)], chid,chfreq,chbw,chmodf,chinter)
                #print SQL
                #sys.stdout.flush()
                ora.execone(SQL)
                i = i+1
                if (i%50)==0:
                    ora.commit()
            truncsql = "delete from cmts_if where companyno='%s' and cmts_id='%s' and synctime is NULL" % (xso, xcmtsid)
            ora.execone(truncsql)
            ora.commit()
        except Exception, detail:
            print '['+nowdate+']',
            print xcmtsid,
            print detail
            pass
            SQL = "update cmts set mflag=-1,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
            ora.execone(SQL)
            ora.commit()
            cmts_idx = cmts_idx+1
            continue

        sys.stdout.flush()

        if xmflag==1:
            try:
                print macupchnidx
                upidx_array = agent.snmpbulkwalk([xIP, '-c', xcomm, macupchnidx])
                i=0
                lens=len(upidx_array)
                while i<lens:
                    xid = upidx_array[i][0].replace(macupchnidx+'.','')
                    xvalue = upidx_array[i][1]
                    result[xcmtsid+'-UPIDX-'+str(xid)] = xvalue
                    i = i+1

                print macstatusidx
                status_array = agent.snmpbulkwalk([xIP, '-c', xcomm, macstatusidx])
                i=0
                lens=len(status_array)
                while i<lens:
                    xid = status_array[i][0].replace(macstatusidx+'.','')
                    xvalue = status_array[i][1]
                    result[xcmtsid+'-STATUS-'+str(xid)] = xvalue
                    i = i+1

                print macdownchnidx
                downidx_array = agent.snmpbulkwalk([xIP, '-c', xcomm, macdownchnidx])
                i=0
                lens=len(downidx_array)
                while i<lens:
                    xid = downidx_array[i][0].replace(macdownchnidx+'.','')
                    xvalue = downidx_array[i][1]
                    result[xcmtsid+'-DOWNIDX-'+str(xid)] = xvalue
                    i = i+1

                print cmipidx
                cmip_array = agent.snmpbulkwalk([xIP, '-c', xcomm, cmipidx])
                i=0
                lens=len(cmip_array)
                while i<lens:
                    xid = cmip_array[i][0].replace(cmipidx+'.','')
                    xvalue = cmip_array[i][1]
                    result[xcmtsid+'-IP-'+str(xid)] = xvalue
                    i = i+1

                print macidx_mib
                macidx_array = agent.snmpwalk([xIP, '-c', xcomm, macidx_mib])
                print 'CM MAC '
                i=0
                lens=len(macidx_array)
                while i<lens:
                    xid = macidx_array[i][0].replace(macidx_mib+'.','')
                    mac = xid.split('.')
                    cmmac = "%.2X%.2X%.2X%.2X%.2X%.2X" % (int(mac[0]), int(mac[1]),  int(mac[2]),  int(mac[3]),  int(mac[4]),  int(mac[5]))
                    xvalue = macidx_array[i][1]
                    try:
                        xuplnkidx = result[xcmtsid+'-UPIDX-'+str(xvalue)]
                    except Exception, detail:
                        xuplnkidx = -1
                        pass
                    try:
                        xdownlnkidx = result[xcmtsid+'-DOWNIDX-'+str(xvalue)]
                    except Exception, detail:
                        xdownlnkidx = -1
                        pass
                    try:
                        xuplnkintf = result[xcmtsid+'-DSCRV-'+str(xuplnkidx)]
                    except Exception, detail:
                        xuplnkintf = ''
                        pass
                    try:
                        xdownlnkintf = result[xcmtsid+'-DSCRV-'+str(xdownlnkidx)]
                    except Exception, detail:
                        xdownlnkintf = ''
                        pass
                    try:
                        cmip = result[xcmtsid+'-IP-'+str(xvalue)]
                    except Exception, detail:
                        cmip = ''
                        pass
                    try:
                        status = result[xcmtsid+'-STATUS-'+str(xvalue)]
                    except Exception, detail:
                        status = -1
                        pass

                    SQL = "select idx from cmmac where cmmac='%s'" % (cmmac)
                    rs2 = ora.execall(SQL)
                    reclen = len(rs2)
                    if rs2 is not None and reclen>0:
                        SQL = "update cmmac set idx=%d,ip='%s',uplink_idx=%d,dllink_idx=%d,status=%d,updatetime=sysdate,companyno='%s',cmts_id='%s' where cmmac='%s'" % (xvalue, cmip, xuplnkidx, xdownlnkidx, status, xso, xcmtsid, cmmac)
                    else:
                        SQL = "insert into cmmac (companyno,cmts_id,cmmac,idx,ip,uplink_idx,dllink_idx,status,updatetime,synctime) values ('%s','%s','%s',%d, '%s',%d,%d,%d,sysdate,sysdate-0.8)" % (xso, xcmtsid, cmmac, xvalue, cmip, xuplnkidx, xdownlnkidx, status)
                    #print SQL
                    sys.stdout.flush()
                    ora.execone(SQL)
                    if (i%50)==0:
                        ora.commit()
                    i = i+1
            except Exception, detail:
                print '['+nowdate+']',
                print xcmtsid
                print detail
                SQL = "update cmts set mflag=-1,synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xso, xcmtsid)
                ora.execone(SQL)
        else:
            pass
        SQL = "update cmts set mflag=0,sys_descr='%s',synctime=sysdate where companyno='%s' and cmts_id='%s'" % (cmts_descr, xso, xcmtsid)
        ora.execone(SQL)
        ora.commit()
        print '%s %s is complete...' % (xso, xcmtsid)
        sys.stdout.flush()
        cmts_idx = cmts_idx+1

    exec_time = int(time.time())

    if exec_time-pre_exec_time>300:
        cmts_ip={}
        cmts_id={}
        cmts_so={}
        cmts_comm={}
        cmts_type={}
        cmts_cnt = 0

        cmtssql = "select a.companyno,a.cmts_id,a.ip,a.snmp_ro, \
                   case \
                     when upper(b.maker||b.model) like '%%UBR%%' then 'UBR' when upper(b.maker||b.model) like '%%CASA%%' then 'CASA' \
                     when upper(b.maker||b.model) like '%%CUDA%%' then 'CUDA' when upper(b.maker||b.model) like '%%MOTO%%' then 'MOTO' else NULL end type \
                   from nms.cmts a \
                   inner join nms.sys_object b on b.ne_id=substr(a.cmts_id,-8,4) and b.stopyn='N' \
                   where \
                   a.companyno='101' and \
                   a.ip is not NULL and a.snmp_ro is not NULL and a.stopyn='N' and \
                   (upper(b.maker||b.model) like '%%UBR%%' or upper(b.maker||b.model) like '%%CASA%%') \
                   order by a.companyno,a.cmts_id asc"
        #cmtssql = "select so,cmts_id,ip,snmp_ro,type from EM_CMTS where substr(type,1,3) in ('UBR','Cas') order by so,cmts_id"
        rs1 = ora.execall(cmtssql)
        if rs1 is not None and len(rs1)>0:
            for aw in rs1:
                cmts_so[cmts_cnt] = aw[0]
                cmts_id[cmts_cnt] = aw[1]
                cmts_ip[cmts_cnt] = aw[2]
                cmts_comm[cmts_cnt] = aw[3]
                cmts_type[cmts_cnt] = aw[4]
                cmts_cnt = cmts_cnt+1

        #if cmts_cnt<=0:
        #    print 'Continue......'

        cmts_idx = 0
        while cmts_idx<cmts_cnt:
            try:
                result = {}
                nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
                xso = cmts_so[cmts_idx]
                xcmtsid = cmts_id[cmts_idx]
                xIP = cmts_ip[cmts_idx]
                xcomm = cmts_comm[cmts_idx]
                xtype = cmts_type[cmts_idx]

                #print '['+nowdate+']',
                #print xso, xcmtsid, xIP

                if xtype=='CASA':
                    mib = "%s" % (casa_cpu_mib)
                    temp_mib = "%s" % (casa_temp_mib)
                    temp_div = 10
                else:
                    mib = "%s" % (ubr10k_cpu_mib)
                    temp_mib = "%s" % (ubr10k_temp_mib)
                    temp_div = 1
                #print "snmpget -v2c -c %s %s %s" % (xcomm, xIP, mib)
                rets = agent.snmpget([xIP, '-c', xcomm, mib])
                #print rets
                if rets is not None and rets[0][1]!='':
                    xcpu = int(rets[0][1])
                else:
                    xcpu = -1
                rets = agent.snmpget([xIP, '-c', xcomm, temp_mib])
                #print rets
                if rets is not None and rets[0][1]!='':
                    xtemp = int(rets[0][1])/temp_div
                else:
                    xtemp = -1
                SQL = "update cmts set cpu='%d',tpt='%d',synctime=sysdate where companyno='%s' and cmts_id='%s'" % (xcpu, xtemp, xso, xcmtsid)
                print SQL
                ora.execone(SQL)

            except Exception, detail:
                print '['+nowdate+']',
                print xcmtsid
                print detail
                pass
            ora.commit()
            sys.stdout.flush()
            cmts_idx = cmts_idx+1
        pre_exec_time = exec_time
    ora.se_close()
    time.sleep(10)
sys.exit(0)
