                                    resp = cafunc.gw_add_prod(sid, bg_date, end_date, icc_no, channel, '1')
                                elif cmd=='B2':
                                    resp = cafunc.gw_cancel_prod(sid, bg_date, end_date, icc_no, channel)
                                elif cmd=='B21':
                                    resp = cafunc.gw_cancel_prod_1day(sid, bg_date, end_date, icc_no, channel)
