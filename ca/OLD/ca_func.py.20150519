      def gw_PVR_hd_storage(self, sid, bgd, endd, icc, size):
          iccs = icc[:10]
          try:
              xsize = int(size)
          except:
              pass
              return -1
          if size<30000:
              sz = "%.4X" % (size)
              cmd = self.ird_cmd('19701102'+sz);
              if self.gw_combo('00',sid, bgd, endd, iccs, cmd)<0:
                  return -1
              return 1
          else:
              return -1

