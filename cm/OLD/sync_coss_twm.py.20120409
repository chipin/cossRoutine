#!/usr/bin/env python
# -*- coding: Big5 -*-
import sys
import os
import string
import time
import binascii
import threading
import pymssql
from pysnmp.error import PySnmpError
from pysnmpclass import snmpclass
from oraclass import ORA

cmstatus_mib = '.1.3.6.1.2.1.10.127.1.3.3.1.9'
thread_cnt = 0
status_arr = {}
thread_arr = {}
loop = 0

CossMSDB = ['kbroCossMS_CP950','CossMS_CG_CP950','TFMCossMS_CP950']



def query_status(loop, cmidx, ip):
    global cmstatus_mib, thread_cnt, status_arr
    thread_cnt = thread_cnt+1
    try:
        mib = "%s.%d" % (cmstatus_mib, cmidx)
        agt = snmpclass(version='v1',community='NMS_Snmp',ptimeout=2,pretries=2,debug=0)
        rets = agt.snmpget([ip, '-c', 'NMS_Snmp', mib])
        print ip+': '+mib
        if rets is not None and rets[0][1]!='':
            status_arr['STATUS-'+str(loop)] = int(rets[0][1])
        else:
            status_arr['STATUS-'+str(loop)] = -1
    except Exception, msg:
        print msg
        status_arr['STATUS-'+str(loop)] = None
        pass
    thread_cnt = thread_cnt-1



for db in CossMSDB:
    print db

    sql = "select companyno,subsid,singlesn from ms0200 with (nolock) \
           where subsname='台灣大哥大股份有限公司' and servicename in ('2 cm') and custstatus in ('0 未收','1 正常','8 欠費中') order by companyno,subsid";

    try:
        con = pymssql.connect(dsn='%s@%s') % ('cnis_web',db)
        cur = con.cursor()

    except Exception, msg:
        nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
        print '['+nowdate+']:'+str(msg)
        sys.exit(0)


    try:
        cur.execute(sql)
        xarr = cur.fetchall()
        for ms_row in xarr:
            companyno = ms_row[0]
            subsid = ms_row[1]
            singlesn = ms_row[2]
            print companyno,subsid,singlesn
    except Exception, msg:
        nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
        print '['+nowdate+']:'+str(msg)



