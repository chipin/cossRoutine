ora = ORA('nms@cnis')
if not ora.db:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+']: Unable to connect to server [CNIS]'
    sys.exit(0)

oraoems = ORA('oems@kbro_nmsdb')
if not oraoems.db:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+']: Unable to connect to server [OEMS]'
    sys.exit(0)

while 1:
    status_arr = {}
    thread_arr = {}
    loop = 0
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print nowdate

    SQL = "select * from ( \
             select a.companyno,a.subsid,b.cmmac,b.node,b.link,(b.city||b.district||b.addrname) instaddr,(b.city||'-'||b.district) instarea,b.cmts_id,b.idx,b.synctime,c.ip cmts_ip,c.snmp_ro,a.oems_id,d.oemsno from cmmac_outdoor a \
             inner join cmmac b on b.companyno=a.companyno and b.subsid=a.subsid \
             inner join cmts c on c.companyno=a.companyno and c.cmts_id=b.cmts_id \
             inner join so d on d.companyno=a.companyno \
             where a.owner='TWM' and a.stopyn='N' and b.cmts_id is not null and b.idx is not null and c.ip is not null and c.snmp_ro is not null \
             and (a.updatetime > sysdate-1 or a.updatetime is null) and (b.synctime < sysdate-(5/(24*60)) or b.synctime is null) \
             order by b.synctime asc \
           ) where rownum <= 50"
    #print SQL
    rs1 = ora.execall(SQL)
    reclen = len(rs1)
    if rs1 is not None and reclen>0:
        for aw in rs1:
            so = aw[0]
            subsid = aw[1]
            cmmac = aw[2]
            node = aw[3]
            link = aw[4]
            instaddr = aw[5]
            instarea = aw[6]
            cmts_id = aw[7]
            cm_idx = aw[8]
            cmts_ip = aw[10]
            snmp_ro = aw[11]
            oems_id = aw[12]
            oems_no = aw[13]

            status_arr['SO-'+str(loop)] = so
            status_arr['SUBSID-'+str(loop)] = subsid
            status_arr['MAC-'+str(loop)] = cmmac
            status_arr['IDX-'+str(loop)] = cm_idx
            status_arr['NODE-'+str(loop)] = node
            status_arr['LINK-'+str(loop)] = link
            status_arr['ADDR-'+str(loop)] = instaddr
            status_arr['AREA-'+str(loop)] = instarea
            status_arr['CMTS-'+str(loop)] = cmts_id
            status_arr['IP-'+str(loop)] = cmts_ip
            status_arr['OEMSID-'+str(loop)] = oems_id
            status_arr['OEMSNO-'+str(loop)] = oems_no
            status_arr['STATUS-'+str(loop)] = -1
            status_arr['DONE-'+str(loop)] = -1
            thread_arr[loop] = threading.Thread(target = query_status, args = (loop, cm_idx, cmts_ip, snmp_ro))
            thread_arr[loop].start()
            loop = loop+1
        if loop > 0:
            status_arr['NECNT'] = loop
        sys.stdout.flush()
    else:
        break
    time.sleep(10)


    complete_cnt = 0
    old_complete_cnt = 0
    check_count = 0
    while complete_cnt < status_arr['NECNT']:
        i = 0
        while i<status_arr['NECNT']:
            if status_arr['DONE-'+str(i)]==1:
                to_DB(i)
                complete_cnt = complete_cnt+1
                sys.stdout.flush()
            i = i+1
        if complete_cnt != old_complete_cnt:
            check_count = 0
            old_complete_cnt = complete_cnt
        else:
            check_count = check_count+1
            if check_count>10:
                print 'Error: Timeout (COMPLETE: %.5d)' % (complete_cnt)
                break
        sys.stdout.flush()
        time.sleep(5)


    sys.stdout.flush()

    #break

