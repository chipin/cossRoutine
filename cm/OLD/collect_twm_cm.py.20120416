#!/usr/bin/env python
# -*- coding: big5 -*-
import sys, time
import threading
from pysnmpclass import snmpclass
from oraclass import ORA

cmstatus_mib = '.1.3.6.1.2.1.10.127.1.3.3.1.9'
#cmstatus_map = {-1:'Unknown', 1:'Other', 2:'Ranging', 3:'RangingAborted', 4:'RangingComplete', 5:'IPComplete', 6:'RegistrationComplete', 7:'AccessDenied'}
cmstatus_map = {-1:'Unknown', 1:'Offline', 2:'Ranging', 3:'RangingAborted', 4:'RangingComplete', 5:'IPComplete', 6:'Online', 7:'AccessDenied'}

def query_status(loop, cmidx, ip, comm):
    global cmstatus_mib, status_arr
    try:
        mib = "%s.%d" % (cmstatus_mib, cmidx)
        agt = snmpclass(version='v1',ptimeout=1,pretries=3)
        rets = agt.snmpget([ip, '-c', comm, mib])
        if rets is not None and rets[0][1]!='':
            status_arr['STATUS-'+str(loop)] = int(rets[0][1])
        else:
            status_arr['STATUS-'+str(loop)] = -1
    except Exception, msg:
        print msg
    status_arr['DONE-'+str(loop)] = 1
    print str(loop) + ': ' + ip + ', ' + mib + ', ' + str(status_arr['STATUS-'+str(loop)])

