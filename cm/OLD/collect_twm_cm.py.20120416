def to_DB(loop):
    global ora, oraoems, status_arr
    status_arr['DONE-'+str(loop)] = 2

    updsql = "update cmmac set synctime=sysdate,status='%d' where companyno='%s' and subsid='%d'" % (status_arr['STATUS-'+str(loop)], status_arr['SO-'+str(loop)], status_arr['SUBSID-'+str(loop)])
    print str(loop) + ': ' + updsql
    try:
        ora.execone(updsql)
        #pass
    except Exception, msg:
        nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
        print 'Exception: ['+nowdate+']'+str(msg)

    status_str = 'Unknown'
    if status_arr['STATUS-'+str(loop)] >= -1 and status_arr['STATUS-'+str(loop)] <= 7:
        status_str = cmstatus_map[status_arr['STATUS-'+str(loop)]]
    descr = "SO:%s, SubsID:%d, MAC:%s, NODE:%s, LINK:%s, ADDR:%s, Status:%s" % (status_arr['SO-'+str(loop)], status_arr['SUBSID-'+str(loop)], status_arr['MAC-'+str(loop)], status_arr['NODE-'+str(loop)], status_arr['LINK-'+str(loop)], status_arr['ADDR-'+str(loop)], status_str)
    print descr

    #if status_arr['OEMSID-'+str(loop)] == 237258:
    #    status_arr['STATUS-'+str(loop)] = 6

    if status_arr['OEMSID-'+str(loop)] is not None: # 已有告警
        if status_arr['STATUS-'+str(loop)] == 6: # 恢復正常
            updsql = "insert into oems_tickets_log (sid,status_date,descr,account) values ('%d',sysdate,'CM Status: Online 已恢復正常','CMMON')" % (status_arr['OEMSID-'+str(loop)])
            print updsql
            oraoems.execone(updsql)

            updsql = "update cmmac_outdoor set errortime=NULL,oems_id=NULL where companyno='%s' and subsid='%d'" % (status_arr['SO-'+str(loop)], status_arr['SUBSID-'+str(loop)])
            print updsql
            ora.execone(updsql)
        else: # 持續異常
            pass
    else: # 尚未有告警
        if status_arr['STATUS-'+str(loop)] != 6: # 初次異常
            sid = 0
            updsql = "begin insert into oems_tickets_main (status,type,subtype,reason,descr,create_date,operator,account,normal_flag,impact_list) values ('5120',3111,311106,'OutdoorCM異常','%s',sysdate,'%s','CMMON','A','%d') return to_char(sid) into :1 ; end;" % (descr, status_arr['OEMSNO-'+str(loop)], status_arr['SUBSID-'+str(loop)])
            print updsql
            oems_sid_ary = oraoems.db.BindingArray(1,12,'SQLT_STR')
            oraoems.c.execute(updsql, oems_sid_ary)
            sid = int(oems_sid_ary[0])

            updsql = "insert into oems_tickets_log (sid,status_date,orig_status,status,descr,account) values ('%d',sysdate,'5120','5120','%s','CMMON')" % (sid, descr)
            print updsql
            oraoems.execone(updsql)

            updsql = "insert into oems_impact (sid,type,value,companyno,node,area) values ('%d','SUBSID','%d','%s','%s','%s')" % (sid, status_arr['SUBSID-'+str(loop)], status_arr['SO-'+str(loop)], status_arr['NODE-'+str(loop)], status_arr['AREA-'+str(loop)])
            print updsql
            oraoems.execone(updsql)

            updsql = "update cmmac_outdoor set errortime=sysdate,oems_id='%d' where companyno='%s' and subsid='%d'" % (sid, status_arr['SO-'+str(loop)], status_arr['SUBSID-'+str(loop)])
            print updsql
            ora.execone(updsql)
        else: # 一切正常
            pass

    ora.commit()
    oraoems.commit()

