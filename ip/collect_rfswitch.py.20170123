#!/usr/bin/env python
# -*- coding: utf-8 -*-
# 中文字編碼
import os,sys,time
import MySQLdb
from pysnmpclass import snmpclass
from oraclass import ORA

reload(sys)
sys.setdefaultencoding('utf8')
os.environ["NLS_LANG"] = 'AMERICAN_AMERICA.UTF8'

ora = ORA('nms@cnis')
if not ora.db:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+'] Error: Unable to connect to server [CNIS]'
    sys.exit(0)


snmp_oid = {}

# Get OID
SQL = "select name,oid from snmp_mib where name in ('DEVChStatus','DEVChCtrl','TekronChStatus','TekronChCtrl')"
rst = ora.execall(SQL)
if rst is not None and len(rst)>0:
    for aw in rst:
        try:
            xname = aw[0]
            xoid = aw[1]
            snmp_oid[xname] = xoid
        except Exception, msg:
            print 'Exception: '+str(msg)

if len(snmp_oid) == 0:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+'] Error: SNMP_MIB is empty'

    if ora is not None:
        ora.se_close()
    sys.exit(0)


dtv_so = {}
dtv_id = {}
dtv_ip = {}
dtv_comm = {}
dtv_maker = {}
dtv_cnt = 0

SQL = "select a.companyno,a.dtv_id,a.type,a.ip,a.snmp_ro,a.snmp_rw,b.maker,b.model \
       from dtv_ne a \
       inner join sys_object b on b.ne_id=substr(a.dtv_id,-8,4) and b.stopyn='N' \
       where a.type='RF' and a.stopyn='N' and b.maker in ('DEV','Tekron') and a.ip is not null and a.snmp_ro is not null \
       order by a.companyno,a.dtv_id"
rst = ora.execall(SQL)
if rst is not None and len(rst)>0:
    for aw in rst:
        try:
            dtv_so[dtv_cnt] = aw[0]
            dtv_id[dtv_cnt] = aw[1]
            dtv_ip[dtv_cnt] = aw[3]
            dtv_comm[dtv_cnt] = aw[4]
            dtv_maker[dtv_cnt] = aw[6]
            dtv_cnt = dtv_cnt+1
        except Exception, msg:
            print 'Exception: '+str(msg)

if len(dtv_id) == 0:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+'] Error: DTV RF Device is empty'

    if ora is not None:
        ora.se_close()
    sys.exit(0)


try:
    mydb = MySQLdb.connect(host="TFM-QOS", user="root", passwd="newom123", db="cmdb_500")
    mydbcur = mydb.cursor()
except Exception, msg:
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+'] Error: Unable to connect to server [MYSQL]'
    sys.exit(0)


ora_retry = mydb_retry = 0
startime = time.time()
while 1:
    try:
        ora.execone('select sysdate from dual')
        ora_retry = 0
    except Exception, msg:
        print str(msg)

        print 'Error: Lost connection to [CNIS], trying to reconnect'
        ora_retry = ora_retry + 1
        ora = ORA('nms@cnis')
        if not ora.db:
            nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
            if ora_retry >= 10:
                print '['+nowdate+'] Error: Lost connection to [CNIS], fail to retry [EXIT]'
                break
            else:
                print '['+nowdate+'] Error: Unable to reconnect to server [CNIS]',ora_retry
                sys.stdout.flush()
                time.sleep(300)
                continue

    try:
        mydb.ping()
        mydb_retry = 0
    except Exception, msg:
        print str(msg)

        print 'Error: Lost connection to [MYSQL], trying to reconnect'
        mydb_retry = mydb_retry + 1
        try:
            mydb = MySQLdb.connect(host="TFM-QOS", user="root", passwd="newom123", db="cmdb_500")
            mydbcur = mydb.cursor()
        except Exception, msg:
            nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
            if mydb_retry >= 10:
                print '['+nowdate+'] Error: Lost connection to [MYSQL], fail to retry [EXIT]'
                break
            else:
                print '['+nowdate+'] Error: Unable to reconnect to server [MYSQL]',mydb_retry
                sys.stdout.flush()
                time.sleep(300)
                continue

    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print '['+nowdate+'] START'

    idx = 0
    while idx < dtv_cnt:
        try:
            xso = dtv_so[idx]
            xneid = dtv_id[idx]
            xip = dtv_ip[idx]
            xmaker = dtv_maker[idx]
            xcomm = dtv_comm[idx]
            print xso,xneid,xip,xmaker

            agent = snmpclass(version='v1',ptimeout=1,pretries=3,debug=0)

            zresult = {}
            ch1_status = ch2_status = ch1_mode = ch2_mode = 'null'

            if xmaker.find('DEV') >= 0:
                try:
                    xoid = snmp_oid['DEVChStatus']
                    rets = agent.snmpwalk([xip, '-c', xcomm, xoid])
                    print 'DEVChStatus',xoid,rets
                    i = 0
                    lens = len(rets)
                    while i<lens:
                        zid = rets[i][0].replace(xoid+'.','')
                        try:
                            zvalue = rets[i][1].strip().replace('\'','')
                        except:
                            zvalue = rets[i][1]
                        print '('+str(lens)+'CH)',str(zid)+':'+str(zvalue)
                        zresult['DEVChStatus-%s' % (zid)] = zvalue
                        if lens == 12:
                            break
                        i = i+1
                except:
                    pass
                try:
                    ch1_status = zresult['DEVChStatus-1']
                except:
                    ch1_status = 'null'
                try:
                    ch2_status = zresult['DEVChStatus-2']
                except:
                    ch2_status = 'null'
                sys.stdout.flush()
            elif xmaker.find('Tekron') >= 0:
                try:
                    xoid = snmp_oid['TekronChStatus']
                    rets = agent.snmpwalk([xip, '-c', xcomm, xoid])
                    print 'TekronChStatus',xoid,rets
                    i = 0
                    lens = len(rets)
                    while i<lens:
                        zid = rets[i][0].replace(xoid+'.','')
                        if zid in ['3','4','7','8']:
                            try:
                                zvalue = rets[i][1].strip().replace('\'','')
                            except:
                                zvalue = rets[i][1]
                            print '('+str(lens)+'CH)',str(zid)+':'+str(zvalue)
                            zresult['TekronChStatus-%s' % (zid)] = zvalue
                        i = i+1
                        if i == 8:
                            break
                except:
                    pass
                try:
                    xoid = snmp_oid['TekronChCtrl']
                    rets = agent.snmpwalk([xip, '-c', xcomm, xoid])
                    print 'TekronChCtrl',xoid,rets
                    i = 0
                    lens = len(rets)
                    while i<lens:
                        zid = rets[i][0].replace(xoid+'.','')
                        if zid in ['3','7']:
                            try:
                                zvalue = rets[i][1].strip().replace('\'','')
                            except:
                                zvalue = rets[i][1]
                            print '('+str(lens)+'CH)',str(zid)+':'+str(zvalue)
                            zresult['TekronChCtrl-%s' % (zid)] = zvalue
                        i = i+1
                        if i == 7:
                            break
                except:
                    pass
                try:
                    ch1_status = zresult['TekronChStatus-3']
                except:
                    ch1_status = 'null'
                try:
                    #ch1_mode = zresult['TekronChStatus-4']
                    ch1_mode = int(zresult['TekronChCtrl-3']) * int(zresult['TekronChStatus-4'])
                    ch1_mode = ch1_mode%3
                    #print int(zresult['TekronChCtrl-3']), int(zresult['TekronChStatus-4']), ch1_mode
                except:
                    ch1_mode = 'null'
                try:
                    ch2_status = zresult['TekronChStatus-7']
                except:
                    ch2_status = 'null'
                try:
                    #ch2_mode = zresult['TekronChStatus-8']
                    ch2_mode = int(zresult['TekronChCtrl-7']) * int(zresult['TekronChStatus-8'])
                    ch2_mode = ch2_mode%3
                    #print int(zresult['TekronChCtrl-7']), int(zresult['TekronChStatus-8']), ch2_mode
                except:
                    ch2_mode = 'null'
                sys.stdout.flush()

            SQL = "update dtv_ne set ch1_status=%s,ch2_status=%s,ch1_mode=%s,ch2_mode=%s,synctime=sysdate where companyno='%s' and dtv_id='%s'" % (ch1_status, ch2_status, ch1_mode, ch2_mode, xso, xneid)
            print SQL
            if ch1_status != 'null' or ch2_status != 'null' or ch1_mode != 'null' or ch2_mode != 'null':
                try:
                    print 'execute SQL'
                    ora.execone(SQL)
                    ora.commit()
                    #pass
                except Exception, msg:
                    print 'Exception: '+str(msg)
                    sys.exit(0)

            #sid = (int)((time.time()/300)%115200)
            sid = (int)((time.time()/300)%57600)
            xtime = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())

            SQL = "replace into rfswitch_chstatus (sid,ne_id,updatetime,ch1,ch2,ch1_mode,ch2_mode) values (%d,'%s','%s',%s,%s,%s,%s)" % (sid, xneid, xtime, ch1_status, ch2_status, ch1_mode, ch2_mode)
            print SQL
            if ch1_status != 'null' or ch2_status != 'null' or ch1_mode != 'null' or ch2_mode != 'null':
                try:
                    print 'execute SQL'
                    mydbcur.execute(SQL)
                    mydb.commit()
                    #pass
                except Exception, msg:
                    print 'Exception: '+str(msg)

        except Exception, msg:
            print 'Exception: '+str(msg)

        sys.stdout.flush()
        idx = idx+1

    endtime = time.time()
    nowdate = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
    print "[%s] END (totalsec: %d)\n" % (nowdate, endtime-startime)
    sys.stdout.flush()

    #break # 測試用

    while endtime-startime<300:
        print 'sleep 30 secs ...'
        sys.stdout.flush()
        time.sleep(30)
        endtime = time.time()
    startime = time.time()

if ora is not None:
    ora.se_close()
if mydb is not None:
    mydb.close()
sys.exit(0)
