#!/usr/bin/env python
# -*- coding: Big5 -*-
import sys,datetime,string,types
import pymssql
from oraclass import ORA

con = pymssql.connect(host='CossMS',user='proguser',password='cossuser',database='cossdb')
cur = con.cursor()

oracon = ORA('oems/oems@KBRONMS')
SQL="update oems_impact set getimpactsubsid=null where sid in (SELECT sid FROM oems_impact where result='ERROR' and createtime>=sysdate-1) and result='ERROR' and companyno in ('101','103','104','300','701')"
oracon.execone(SQL)
oracon.commit()
orasql = "select sid,type,value,companyno,node from oems_impact where getimpactsubsid is null and companyno is not null and value is not null and companyno in ('101','103','104','300','701') order by sid,type"
print orasql
rs = oracon.execall(orasql)
if rs is not None and len(rs) > 0:
    ii = 0
    jj = len(rs)
    kk = 0
    oldsid = 0
    print rs
    for a_row in rs:
        ii = ii+1
        sid = a_row[0]
        if(oldsid!=sid):
            oldsid = sid
            kk = ii-1
        type = a_row[1]
        value = a_row[2]
        companyno = a_row[3]
        cur_main = cur
        node_value = a_row[4]
        if node_value is None:
            node_sql = "B.nodeno is not null"
        else:
            node_sql = "B.nodeno='%s'" % (node_value)
        print sid,type,value,companyno
        if sid is None:
            print '[SID] = NULL'
            continue
        if type is not None:
            if type=='ROAD':
                sqls = "select distinct A.subsid,A.servicename,A.subsname,B.nodeno,B.addrname,C.mailtitle,B.mduname,B.linkid \
                        from ms0200 A with (nolock) inner join ms0102 B with (nolock) on A.custid = B.custid and A.companyno=B.companyno \
                        inner join ms0100 C with (nolock) on A.custid = C.custid and A.companyno=C.companyno  \
                        where A.companyno='%s' and A.custstatus not in ('4 註銷','5 促銷中','3 已拆','6 裝機中') \
                        and B.addrno = 0 and (B.addrname like '%%%s%%' or B.msregion='%s') and %s" % (companyno, value, value, node_sql)
            elif type=='NODE':
                sqls = "select distinct A.subsid,A.servicename,A.subsname,B.nodeno,B.addrname,C.mailtitle,B.mduname,B.linkid \
                        from ms0200 A with (nolock) inner join ms0102 B with (nolock) on A.custid = B.custid and A.companyno=B.companyno \
                        inner join ms0100 C with (nolock) on A.custid = C.custid and A.companyno=C.companyno  \
                        where A.companyno='%s' and A.custstatus not in ('4 註銷','5 促銷中','3 已拆','6 裝機中') \
                        and B.addrno = 0 and B.nodeno='%s'" % (companyno, value)
            elif type=='LINK':
                sqls = "select distinct A.subsid,A.servicename,A.subsname,B.nodeno,B.addrname,C.mailtitle,B.mduname,B.linkid \
                        from ms0200 A with (nolock) inner join ms0102 B with (nolock) on A.custid = B.custid and A.companyno=B.companyno \
                        inner join ms0100 C with (nolock) on A.custid = C.custid and A.companyno=C.companyno  \
                        where A.companyno='%s' and A.custstatus not in ('4 註銷','5 促銷中','3 已拆','6 裝機中') \
                        and B.addrno = 0 and B.nodeno='%s' and B.linkid='%s'" % (companyno, node_value, value)
            elif type=='SUBSID':
                sqls = "select distinct A.subsid,A.servicename,A.subsname,B.nodeno,B.addrname,C.mailtitle,B.mduname,B.linkid \
                        from ms0200 A with (nolock) inner join ms0102 B with (nolock) on A.custid = B.custid and A.companyno=B.companyno \
                        inner join ms0100 C with (nolock) on A.custid = C.custid and A.companyno=C.companyno  \
                        where A.companyno='%s' and A.custstatus not in ('4 註銷','5 促銷中','3 已拆','6 裝機中') \
                        and B.addrno = 0 and A.subsid='%s'" % (companyno, value)
            else:
                updsql = "update OEMS_IMPACT set getimpactsubsid=sysdate,result='UNKNOWN' where sid=%d and companyno='%s' and type='%s' and value='%s'" % (sid,companyno,type,value)
                oracon.execone(updsql)
                oracon.commit()
                continue
        else:
            print '[Type] = NULL'
            continue
        try:
            print sqls
            cur_main.execute(sqls)
            xarr = cur_main.fetchall()
            for ms_row in xarr:
                vip = 'N'
                try:
                    if ms_row[5] is not None and ms_row[5][0:3]=='009':
                        vip_str = ms_row[5][0:5]
                        if vip_str=='00905' or vip_str=='00906' or vip_str=='00907':
                            vip = 'S'
                        elif vip_str in ['00908','00909','00910','00911','00912']:
                            vip = 'Y'
                except:
                    pass
                inssql = "insert into OEMS_IMPACT_SUBSCRID(sid,companyno,subsid,servicename,create_date,impact,subsname,nodeno,addrname,mduname,vip,linkid) values(%d,'%s',%d,'%s',sysdate,'Y','%s','%s','%s','%s','%s','%s')" % (sid,companyno,ms_row[0],ms_row[1],ms_row[2],ms_row[3],ms_row[4],ms_row[6],vip,ms_row[7])
                print inssql
                try:
                    oracon.execone(inssql)
                except Exception, detail:
                    print '[Insert Error]: '+ str(detail)
                    pass
            updsql = "update OEMS_IMPACT set getimpactsubsid=sysdate,result='OK' where sid=%d and companyno='%s' and type='%s' and value='%s'" % (sid,companyno,type,value)
            oracon.execone(updsql)
            oracon.commit()
        except Exception, detail:
            print sqls
            print detail
            pass
            updsql = "update OEMS_IMPACT set getimpactsubsid=sysdate,result='ERROR' where sid=%d and companyno='%s' and type='%s' and value='%s'" % (sid,companyno,type,value)
            oracon.execone(updsql)
            oracon.commit()

if oracon is not None:
    oracon.se_close()
con.close()
