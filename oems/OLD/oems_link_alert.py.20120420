#!/usr/bin/env python
# -*- coding: big5 -*-
import sys, time
import pymssql
from oraclass import ORA

if len(sys.argv)<2:
    print "Usage: %s [KBRO|CG|TFM]" % (sys.argv[0])
    sys.exit(0)
else:
    so = sys.argv[1].upper()

if so == 'KBRO':
    con = pymssql.connect(dsn='cnis_web@kbroCossMS_CP950')
    con_qry = pymssql.connect(dsn='cnis_web@kbroCossMS_CP950')
elif so == 'CG':
    con = pymssql.connect(dsn='cnis_web@CossMS_CG_CP950')
    con_qry = pymssql.connect(dsn='cnis_web@CossMS_CG_CP950')
elif so == 'TFM':
    con = pymssql.connect(dsn='cnis_web@TFMCossMS_CP950')
    con_qry = pymssql.connect(dsn='cnis_web@TFMCossMS_CP950')
else:
    print "Usage: %s [KBRO|CG|TFM]" % (sys.argv[0])
    sys.exit(0)

try:
  cur = con.cursor()
  cur_qry = con_qry.cursor()
except:
    print "Exception: Unable to connect CossMS [%s]" % (so)
    sys.exit(0)

oracon_upd = ORA('OEMS@KBRO_NMSDB')
if not oracon_upd.db:
    sys.exit(0)

oracon_cti = ORA('CTI@KBRO_NMSDB')
if not oracon_cti.db:
    sys.exit(0)


tme = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())
print "[%s] => %s" % (tme, so)

so_name = {}
oraqrysql = "select name,id from oems_mapping where type='OPERATOR' and name is not null"
rs = oracon_upd.execall(oraqrysql)
if rs != None and len(rs) > 0:
    for a_row in rs:
       so_name[a_row[0]] = a_row[1]

node_arr = {}

for QQ in range(0, 2):
    for WW in range(0, 3):
        tme = time.strftime("%Y/%m/%d %H:%M:%S", time.localtime())

        if QQ == 0: # 1 day
            EE = '1天'
            if WW == 0: # NODE
                query="select companyno,mscitya,msdistricta,nodeno,count(*) cnt from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-1 group by companyno,mscitya,msdistricta,nodeno having count(*) >= 12"
                print "[%s] => checking 1 day by NODE" % (tme)
            elif WW == 1: # NODE-LV0
                query="select companyno,mscitya,msdistricta,nodea,count(*) cnt from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-1 group by companyno,mscitya,msdistricta,nodea having count(*) >= 8"
                print "[%s] => checking 1 day by NODE-LV0" % (tme)
            else: # LINK
                query="select companyno,mscitya,msdistricta,linkid,count(*) cnt from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-1 group by companyno,mscitya,msdistricta,linkid having count(*) >= 4 union select companyno,mscitya,msdistricta,cast(subsid as varchar),-1 cnt from v_link_alert where substring(servicename,1,1) = '8' and createtime >= getdate()-1 group by companyno,mscitya,msdistricta,subsid"
                print "[%s] => checking 1 day by LINK included LS" % (tme)
        else: # 1 hr
            EE = '1小時'
            if WW == 0: # NODE
                query="select companyno,mscitya,msdistricta,nodeno,count(*) cnt from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-(1.0/24) group by companyno,mscitya,msdistricta,nodeno having count(*) in (6,7,8,9,10,11)"
                print "[%s] => checking 1 hour by NODE" % (tme)
            elif WW == 1: # NODE-LV0
                query="select companyno,mscitya,msdistricta,nodea,count(*) cnt from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-(1.0/24) group by companyno,mscitya,msdistricta,nodea having count(*) in (4,5,6,7)"
                print "[%s] => checking 1 hour by NODE-LV0" % (tme)
            else: # LINK
                query="select companyno,mscitya,msdistricta,linkid,count(*) cnt from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-(1.0/24) group by companyno,mscitya,msdistricta,linkid having count(*) in (2,3)"
                print "[%s] => checking 1 hour by LINK" % (tme)

        print query
        cur.execute(query)
        #i = 0
        while 1:
            curarr = cur.fetchmany(100)
            #i = i+1
            if curarr:
                xlen = len(curarr)
                for ii in range(0, xlen):
                    companyno = curarr[ii][0]
                    mscitya = curarr[ii][1]
                    msdistricta = curarr[ii][2]
                    netid = curarr[ii][3]
                    district = "%s-%s" % (curarr[ii][1], curarr[ii][2])
                    alert_cnt = curarr[ii][4]
                    print companyno,district,netid,alert_cnt
                    worksheet_arr = []
                    worksheet_str = ''
                    service_count = {}
                    road_arr = []
                    node_arr = {}
                    if companyno and netid and alert_cnt > 0: # for non LS
                        reason_str = "網點# %s %s內已有[%d]戶報修," % (netid, EE, alert_cnt)

                        if QQ == 0: # 1 day
                            if WW == 0: # NODE
                                sidqry="select servicename,worksheet,msroada,nodeno from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-1 and companyno='%s' and nodeno='%s'" % (companyno, netid)
                            elif WW == 1: # NODE-LV0
                                sidqry="select servicename,worksheet,msroada,nodeno from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-1 and companyno='%s' and nodea='%s'" % (companyno, netid)
                            else: # LINK
                                sidqry="select servicename,worksheet,msroada,nodeno from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-1 and companyno='%s' and linkid='%s'" % (companyno, netid)
                        else: # 1 hr
                            if WW == 0: # NODE
                                sidqry="select servicename,worksheet,msroada,nodeno from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-(1.0/24) and companyno='%s' and nodeno='%s'" % (companyno, netid)
                            elif WW == 1: # NODE-LV0
                                sidqry="select servicename,worksheet,msroada,nodeno from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-(1.0/24) and companyno='%s' and nodea='%s'" % (companyno, netid)
                            else: # LINK
                                sidqry="select servicename,worksheet,msroada,nodeno from v_link_alert where substring(servicename,1,1) <> '8' and createtime >= getdate()-(1.0/24) and companyno='%s' and linkid='%s'" % (companyno, netid)
                        print sidqry
                        cur_qry.execute(sidqry);
                        sidarr = cur_qry.fetchall()
                        for ssid in sidarr:
                            srv = ssid[0]
                            if service_count.has_key(srv) == False:
                                service_count[srv] = 0
                            service_count[srv] = service_count[srv] + 1
                            wrk = ssid[1]
                            if wrk not in worksheet_arr:
                                worksheet_arr.append(wrk)
                            rod = ssid[2]
                            nod = ssid[3]
                            if rod not in road_arr:
                                road_arr.append(rod)
                                node_arr[rod] = nod
                                node_arr[netid] = nod

                        for kk, vv in service_count.items():
                            reason_str = "%s %s共%d件," % (reason_str, kk, vv)

                        impact_str = "%s-%s" % (companyno, netid)
                        node_arr[impact_str] = 9 # NODE障礙需等震江工單結案, 才會自動結案

                        # 新增障礙單
                        sid = 0
                        oraqrysql = "select sid from oems_tickets_main where ((type in (3107) and subtype in (310701,310703)) or ticket_id is not null) and status<=5104 and impact_list='%s' and account='COSSv2'" % (impact_str)
                        print oraqrysql
                        rs = oracon_upd.execall(oraqrysql)
                        if rs != None and len(rs) > 0:
                            for a_row in rs:
                                sid = a_row[0]
                            oraupdsql = "update oems_tickets_main set reason='%s',descr='%s' where sid='%d'" % (reason_str, reason_str, sid)
                        else:
                            taipower_sid = ''
                            subtype = 310701
                            oraqrysql = "select sid from oems_tickets_main where reason='台電計畫性停電' and normal_flag='P' and sysdate between impact_bg_date and impact_end_date and operator='%d' and descr like '%%%s%%' order by create_date desc" % (so_name[companyno], node_arr[netid])
                            print oraqrysql
                            rs = oracon_upd.execall(oraqrysql)
                            if rs != None and len(rs) > 0:
                                for a_row in rs:
                                    taipower_sid = (int)(a_row[0])
                                    subtype = 310703
                                    break

                            oraupdsql = "insert into oems_tickets_main(status,type,subtype,reason,descr,create_date,operator,account,normal_flag,impact_list,location) \
                                         values('5100',3107,'%d','%s','%s',sysdate,'%s','COSSv2','B','%s','%s')" % (subtype, reason_str, reason_str, so_name[companyno], impact_str, taipower_sid)
                        print oraupdsql
                        try:
                            oracon_upd.execone(oraupdsql)
                            oracon_upd.commit()
                            #pass
                        except:
                            print 'Exception: Unable to insert/update OEMS_TICKETS_MAIN'

                        # 更新障礙單的路段
                        oraqrysql = "select sid from oems_tickets_main where type in (3107) and subtype in (310701,310703) and status <= 5104 and impact_list='%s' and account='COSSv2'" % (impact_str)
                        rs = oracon_upd.execall(oraqrysql)
                        if rs != None and len(rs) > 0:
                            for a_row in rs:
                                sid = a_row[0]

                            # Checking duplicated road
                            oraqrysql = "select value from oems_impact where type='ROAD' and sid='%d'" % (sid)
                            rs = oracon_upd.execall(oraqrysql)
                            if rs != None and len(rs) > 0:
                                oems_rd = rs
                            else:
                                oems_rd = None

                            for msrd in road_arr:
                                if oems_rd is not None:
                                    duplicated_flag = 0
                                    for oerd in oems_rd:
                                        if oerd[0] == msrd:
                                            duplicated_flag = 1
                                            break
                                    if duplicated_flag == 1:
                                        print 'Skip %s' % (msrd)
                                        continue
                                oraupdsql = "insert into oems_impact (sid,type,value,companyno,node,area) values ('%d','ROAD','%s','%s','%s','%s')" % (sid, msrd, companyno, node_arr[msrd], district)
                                print oraupdsql
                                try:
                                    oracon_upd.execone(oraupdsql)
                                    oracon_upd.commit()
                                    #pass
                                except:
                                    print 'Exception: Unable to insert OEMS_IMPACT'

                            # update CTI010 via WorkSheetNo
                            if worksheet_arr:
                                worksheet_str = "','" . join(worksheet_arr)
                            print worksheet_str
                            if worksheet_str != None and len(worksheet_str) > 0 and sid != None and sid > 0:
                                oraupdsql = "update cti010 set ext_oems_id='%d' where so='%d' and coss_id in ('%s') and coss_id is not null and (ext_oems_id is null or ext_oems_id = 0)" % (sid, int(companyno), worksheet_str)
                                print oraupdsql
                                try:
                                    oracon_cti.execone(oraupdsql)
                                    oracon_cti.commit()
                                    #pass
                                except:
                                    print 'Exception: Unable to update CTI010'

                    elif companyno and netid and alert_cnt == -1: #  for 8 LS, 告警是以訂編為單位
                        sidqry="select subsid,subsname,worksheet,nodeno,linkid from v_link_alert where substring(servicename,1,1) = '8' and createtime >= getdate()-1 and companyno='%s' and subsid='%s'" % (companyno, netid)
                        cur_qry.execute(sidqry);
                        sidarr = cur_qry.fetchall()
                        for ssid in sidarr:
                            subsid = ssid[0]
                            subsname = ssid[1]
                            nodeno = ssid[3]
                            linkid = ssid[4]
                            wrk = ssid[2]
                            if wrk not in worksheet_arr:
                                worksheet_arr.append(wrk)

                        reason_str = "網點# %s 已有專線用戶報修, 訂戶編號: %d, 名稱: %s" % (linkid, subsid, subsname)
                        impact_str = "%s-%s" % (companyno, subsid)
                        #node_arr[impact_str] = 9 # LS障礙不需等震江工單結案, 就可以自動結案

                        # 新增障礙單
                        sid = 0
                        oraqrysql = "select sid from oems_tickets_main where type in (3110) and subtype in (311001,311003) and status<=5104 and impact_list='%s' and account='COSSv2'" % (impact_str)
                        print oraqrysql
                        rs = oracon_upd.execall(oraqrysql)
                        if rs != None and len(rs) > 0:
                            for a_row in rs:
                                sid = a_row[0]
                        else:
                            oraupdsql = "insert into oems_tickets_main(status,type,subtype,reason,descr,create_date,operator,account,normal_flag,impact_list) \
                                        values('5100',3110,311001,'%s','%s',sysdate,'%s','COSSv2','B','%s')" % (reason_str, reason_str, so_name[companyno], impact_str)
                            print oraupdsql
                            try:
                                oracon_upd.execone(oraupdsql)
                                oracon_upd.commit()
                                #pass
                            except:
                                print 'Exception: Unable to insert OEMS_TICKETS_MAIN'

                        if sid == 0:
                            oraqrysql = "select sid from oems_tickets_main where type in (3110) and subtype in (311001) and status<=5104 and impact_list='%s' and account='COSSv2'" % (impact_str)
                            rs = oracon_upd.execall(oraqrysql)
                            if rs != None and len(rs) > 0:
                                for a_row in rs:
                                    sid = a_row[0]
                                oraupdsql = "insert into oems_impact (sid,type,value,companyno,node,area) values ('%d','SUBSID','%s','%s','%s','%s')" % (sid, subsid, companyno, nodeno, district)
                                print oraupdsql
                                try:
                                    oracon_upd.execone(oraupdsql)
                                    oracon_upd.commit()
                                    #pass
                                except:
                                    print 'Exception: Unable to insert OEMS_IMPACT'

                        # update CTI010 via WorkSheetNo
                        if worksheet_arr:
                            worksheet_str = "','" . join(worksheet_arr)
                        print worksheet_str
                        if worksheet_str != None and len(worksheet_str) > 0 and sid != None and sid > 0:
                            oraupdsql = "update cti010 set ext_oems_id='%d' where so='%d' and coss_id in ('%s') and coss_id is not null and (ext_oems_id is null or ext_oems_id = 0)" % (sid, int(companyno), worksheet_str)
                            print oraupdsql
                            try:
                                oracon_cti.execone(oraupdsql)
                                oracon_cti.commit()
                                #pass
                            except:
                                print 'Exception: Unable to update CTI010'

                sys.stdout.flush()
            else:
                break


con.close()
con_qry.close()

# 自動結案
oraqrysql = "select sid,impact_list from oems_tickets_main where account='COSSv2' and status=5104"
rs = oracon_upd.execall(oraqrysql)
ticket_arr = {}
sid_arr = {}
ii = 0
if rs != None and len(rs) > 0:
    for a_row in rs:
        sid = a_row[0]
        implst = a_row[1]
        ticket_arr[ii] = implst
        sid_arr[implst] = sid
        ii = ii+1
jj = 0
while jj<ii:
    try:
        print ticket_arr[jj]
        print node_arr[ticket_arr[jj]]
    except:
        oraupdsql = "update oems_tickets_main set status=5105 where sid='%d'" % (sid_arr[ticket_arr[jj]])
        print oraupdsql
        oracon_upd.execone(oraupdsql)

        #follow bomb close auto_alert tickets(aasql)
        oraupdsql = "update oems_tickets_main set status='5123',close_date=sysdate where ticket_id='%d' and account='COSSv2'" % (sid_arr[ticket_arr[jj]])
        print oraupdsql
        oracon_upd.execone(oraupdsql)
        oracon_upd.commit()
    jj = jj+1

if oracon_upd.db:
    oracon_upd.se_close()
if oracon_cti.db:
    oracon_cti.se_close()
